## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Node modules (si usas npm)
node_modules/

# Database files
*.db
*.db-shm
*.db-wal

# Otros
*.cache
*.log
*.tmp

# Uploads de imágenes y archivos (no versionar contenido subido por usuarios)
**/Uploads/**
!**/Uploads/.gitkeep
**/wwwroot/Uploads/**
!**/wwwroot/Uploads/.gitkeep

# Archivos temporales de desarrollo
*.bak
*.backup
*.old
*Copy*
*copy*