@using CarRental.Core.Models
@using CarRental.Web.Services
@using Blazored.Toast.Services
@inject CarRental.Web.Services.ModalService ModalService
@using CarRental.Core.Models.Dtos
@inject IVehicleSubResourceApiClient<InsurancePolicy, InsurancePolicyForCreationDto> ApiClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="p-4">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-bold text-gray-800">Pólizas de Seguro</h3>
        <button @onclick="() => OnAddRequest.InvokeAsync()" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            + Nueva Póliza
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-6">
            <p class="text-gray-500">Cargando pólizas...</p>
        </div>
    }
    else if (_policies == null || !_policies.Any())
    {
        <div class="text-center py-6">
            <p class="text-gray-500">No hay pólizas de seguro registradas.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full bg-white rounded-xl shadow-md overflow-hidden">
                <thead class="bg-gray-100 text-gray-600 text-sm uppercase">
                    <tr>
                        <th class="px-4 py-3 text-left">Aseguradora</th>
                        <th class="px-4 py-3 text-left">Tipo</th>                        
                        <th class="px-4 py-3 text-left">Monto Cobertura</th>
                        <th class="px-4 py-3 text-left">Prima</th>
                        <th class="px-4 py-3 text-left">Vigencia</th>
                        <th class="px-4 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var policy in _policies)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-800">@policy.InsurerName</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@policy.PolicyType</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@policy.CoverageAmount.ToString("C")</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@policy.Rate</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@policy.StartDate.ToString("dd/MM/yy") - @policy.EndDate.ToString("dd/MM/yy")</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-center">
                                <div class="flex justify-center space-x-2">
                                    <button @onclick="() => OnEditRequest.InvokeAsync(policy)" class="p-2 bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded-full" title="Editar">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </button>
                                    <button @onclick="() => ConfirmDelete(policy.Id)" class="p-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-full" title="Eliminar">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public int VehicleId { get; set; }
    [Parameter] public EventCallback OnAddRequest { get; set; }
    [Parameter] public EventCallback<InsurancePolicy> OnEditRequest { get; set; }

    private List<InsurancePolicy> _policies;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadPolicies();

    public async Task LoadPolicies()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await ApiClient.GetByVehicleIdAsync(VehicleId);
        if (result.IsSuccess)
        {
            _policies = result.Data;
        }
        else
        {
            _policies = new List<InsurancePolicy>();
            ToastService.ShowError(result.ErrorMessage ?? "No se pudieron cargar las pólizas.");
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete(int policyId)
    {
        // Obtener la póliza para mostrar información
        var policy = _policies.FirstOrDefault(p => p.Id == policyId);
        var itemName = policy != null
            ? $"la póliza de {policy.InsurerName}"
            : "esta póliza de seguro";

        var confirmed = await ModalService.ConfirmDeleteAsync(itemName);

        if (confirmed)
        {
            var result = await ApiClient.DeleteAsync(policyId);
            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Póliza eliminada con éxito.");
                await LoadPolicies();
            }
            else
            {
                ToastService.ShowError(result.ErrorMessage ?? "Error al eliminar la póliza.");
            }
        }
    }
}