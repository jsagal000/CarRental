@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using CarRental.Web.Services
@using Blazored.Toast.Services
@inject IVehicleSubResourceApiClient<Repair, RepairForCreationDto> ApiClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="p-4">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-bold text-gray-800">Reparaciones</h3>
        <button @onclick="() => OnAddRequest.InvokeAsync()" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            + Nueva Reparación
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-6">
            <p class="text-gray-500">Cargando reparaciones...</p>
        </div>
    }
    else if (_repairs == null || !_repairs.Any())
    {
        <div class="text-center py-6">
            <p class="text-gray-500">No hay reparaciones registradas.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full bg-white">
                <thead class="bg-gray-100 text-gray-600 text-sm uppercase">
                    <tr>
                        <th class="px-4 py-3 text-left">Fecha</th>
                        <th class="px-4 py-3 text-left">Descripción</th>
                        <th class="px-4 py-3 text-left">Costo</th>
                        <th class="px-4 py-3 text-left">Taller</th>
                        <th class="px-4 py-3 text-left">Kilometraje</th>
                        <th class="px-4 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var repair in _repairs)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-800">@repair.Date.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@repair.Description</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@repair.Cost.ToString("C")</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@repair.WorkshopName</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">@repair.Mileage.ToString("N0") km</td>
                            <td class="px-4 py-3 whitespace-nowrap text-sm text-center">
                                <div class="flex justify-center space-x-2">
                                    <button @onclick="() => OnEditRequest.InvokeAsync(repair)" class="p-2 bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded-full" title="Editar">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </button>
                                    <button @onclick="() => ConfirmDelete(repair.Id)" class="p-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-full" title="Eliminar">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public int VehicleId { get; set; }
    [Parameter] public EventCallback OnAddRequest { get; set; }
    [Parameter] public EventCallback<Repair> OnEditRequest { get; set; }

    private List<Repair> _repairs;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync() => await LoadRepairs();

    public async Task LoadRepairs()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await ApiClient.GetByVehicleIdAsync(VehicleId);
        if (result.IsSuccess)
        {
            _repairs = result.Data;
        }
        else
        {
            _repairs = new List<Repair>();
            ToastService.ShowError(result.ErrorMessage ?? "No se pudieron cargar las reparaciones.");
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task ConfirmDelete(int repairId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de que quieres eliminar esta reparación?");
        if (confirmed)
        {
            var result = await ApiClient.DeleteAsync(repairId);
            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Reparación eliminada con éxito.");
                await LoadRepairs();
            }
            else
            {
                ToastService.ShowError(result.ErrorMessage ?? "Error al eliminar la reparación.");
            }
        }
    }
}