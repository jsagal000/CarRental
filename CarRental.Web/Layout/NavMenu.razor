@using CarRental.Web.Services
@inject AuthStateService AuthState
@inject AuthApiClient AuthApiClient
@inject PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@using CarRental.Core.Models
@using Blazored.Toast.Services
@implements IDisposable

<!-- Navigation bar header -->
<div class="sidebar-header d-flex align-items-center justify-content-between p-3 bg-dark text-white">
    <div class="brand-section d-flex align-items-center @(!IsExpanded ? "d-none" : "")">
        <svg class="brand-icon me-2 text-primary" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
            <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.061L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z" />
        </svg>
        <span class="brand-text fw-bold">CarRental.Web</span>
    </div>

    <div class="header-controls d-flex align-items-center @(!IsExpanded ? "w-100 justify-content-center" : "")">
        <button class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex toggle-btn @(!IsExpanded ? "me-0" : "me-2")"
                @onclick="ToggleExpanded"
                title="@(IsExpanded ? "Contraer" : "Expandir")">
            <svg class="toggle-icon" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="@(IsExpanded ? "M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" : "M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z")" />
            </svg>
        </button>

        <button class="btn btn-sm btn-outline-secondary d-md-none mobile-toggle @(!IsExpanded ? "d-none" : "")"
                @onclick="ToggleNavMenu"
                title="Toggle menu">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
            </svg>
        </button>
    </div>
</div>

<!-- Navigation menu -->
<div class="navigation-content @NavMenuCssClass">
    @if (!AuthState.IsAuthenticated)
    {
        <div class="loading-state p-3 text-center text-muted">
            <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
            <div class="loading-text small">Cargando...</div>
        </div>
    }
    else if (isLoadingPermissions)
    {
        <div class="loading-state p-3 text-center text-muted">
            <div class="spinner-border spinner-border-sm mb-2" role="status"></div>
            <div class="loading-text small">Validando permisos...</div>
        </div>
    }
    else
    {
        <nav class="nav-menu flex-column nav">
            <!-- Dashboard - Siempre visible -->
            <div class="nav-item">
                <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                         ActiveClass="active bg-secondary text-white"
                         href="dashboard"
                         Match="NavLinkMatch.All"
                         title="Dashboard">
                    <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.707 1.5ZM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5 5 5Z" />
                    </svg>
                    <span class="nav-text">Dashboard</span>
                </NavLink>
            </div>

            <!-- Clientes -->
            @if (hasCustomerAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="customers"
                             title="Clientes">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002A.274.274 0 0 1 15 13H7ZM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816ZM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
                        </svg>
                        <span class="nav-text">Clientes</span>
                    </NavLink>
                </div>
            }

            <!-- Vehículos -->
            @if (hasVehicleAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="vehicles"
                             title="Vehículos">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7zm1.294 7.456A1.999 1.999 0 0 1 4.732 11h5.536a2.01 2.01 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456zM12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312L13.27 6.313A.5.5 0 0 0 12.82 6H12v4zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />
                        </svg>
                        <span class="nav-text">Vehículos</span>
                    </NavLink>
                </div>
            }

            <!-- Alquileres -->
            @if (hasRentalAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="rentals"
                             title="Alquileres">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M1 3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1H1zm7 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
                            <path d="M0 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V5zM3 7.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5z" />
                        </svg>
                        <span class="nav-text">Alquileres</span>
                    </NavLink>
                </div>
            }

            <!-- Socios -->
            @if (hasPartnerAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="partners"
                             title="Socios">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                        </svg>
                        <span class="nav-text">Socios</span>
                    </NavLink>
                </div>
            }

            <!-- Reportes Financieros -->
            @if (hasFinancialReportsAccess)
            {
                <div class="nav-item submenu-parent">
                    <div class="nav-link submenu-toggle d-flex align-items-center justify-content-between text-light py-2 px-3"
                         @onclick="ToggleFinancialReportsMenu"
                         title="Reportes Financieros">
                        <div class="d-flex align-items-center">
                            <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5v12h-2V2h2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1h-2zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zM1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-3z" />
                            </svg>
                            <span class="nav-text">Reportes Financieros</span>
                        </div>
                        <svg class="submenu-arrow" width="12" height="12" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="@(isFinancialReportsOpen ? "M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708l6-6z" : "M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z")" />
                        </svg>
                    </div>

                    <div class="submenu @(isFinancialReportsOpen ? "show" : "")">
                        <NavLink class="nav-link submenu-item d-flex align-items-center text-light small py-1 px-3"
                                 ActiveClass="active bg-secondary"
                                 href="financial-reports"
                                 title="Reporte Completo">
                            <svg class="nav-icon me-2" width="12" height="12" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M4 11H2v3h2v-3zm5-4H7v7h2V7zm5-5v12h-2V2h2z" />
                            </svg>
                            <span class="nav-text">Reporte Completo</span>
                        </NavLink>

                        <NavLink class="nav-link submenu-item d-flex align-items-center text-light small py-1 px-3"
                                 ActiveClass="active bg-secondary"
                                 href="vehicle-profitability"
                                 title="Rentabilidad Vehículo">
                            <svg class="nav-icon me-2" width="12" height="12" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M6 1v3H1V1h5zM1 0a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h5a1 1 0 0 0 1-1V1a1 1 0 0 0-1-1H1zm14 12v3h-5v-3h5zm-5-1a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h5a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-5z" />
                            </svg>
                            <span class="nav-text">Rentabilidad</span>
                        </NavLink>
                    </div>
                </div>
            }

            <!-- Gestión de Usuarios -->
            @if (hasUserAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="user-management"
                             title="Gestión de Usuarios">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                        </svg>
                        <span class="nav-text">Usuarios</span>
                    </NavLink>
                </div>
            }

            <!-- Configuración empresa -->
            @if (AuthState.CurrentUser?.Role == UserRole.Admin)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="settings/company"
                             title="Configuración de Empresa">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z" />
                        </svg>
                        <span class="nav-text">Configuración</span>
                    </NavLink>
                </div>
            }

            <!-- Gestión de Permisos -->
            @if (hasPermissionAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="permissions"
                             title="Gestión de Permisos">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                        </svg>
                        <span class="nav-text">Permisos</span>
                    </NavLink>
                </div>
            }

            <!-- Auditoría -->
            @if (hasAuditAccess)
            {
                <div class="nav-item">
                    <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                             ActiveClass="active bg-secondary text-white"
                             href="audit"
                             title="Registro de Auditoría">
                        <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />
                        </svg>
                        <span class="nav-text">Auditoría</span>
                    </NavLink>
                </div>
            }

            <!-- Separador -->
            <div class="nav-item my-2">
                <hr class="border-secondary opacity-25">
            </div>

            <!-- Mi Perfil -->
            <div class="nav-item">
                <NavLink class="nav-link nav-item-link d-flex align-items-center text-light py-2 px-3"
                         ActiveClass="active bg-secondary text-white"
                         href="profile"
                         title="Mi Perfil">
                    <svg class="nav-icon me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" />
                    </svg>
                    <span class="nav-text">Mi Perfil</span>
                </NavLink>
            </div>

            <!-- Logout móvil -->
            <div class="nav-item d-md-none mt-3 pt-2 border-top mobile-logout">
                <button class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-start"
                        @onclick="HandleLogout"
                        title="Cerrar Sesión">
                    <svg class="me-2" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z" />
                        <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z" />
                    </svg>
                    <span>Cerrar Sesión</span>
                </button>
            </div>
        </nav>
    }
</div>

<!-- Footer con info de usuario -->
<div class="user-footer mt-auto p-3 bg-dark border-top text-white @(!IsExpanded ? "d-none" : "")">
    @if (AuthState.IsAuthenticated)
    {
        <div class="user-info d-flex align-items-center">
            <div class="user-avatar rounded-circle bg-primary d-flex align-items-center justify-content-center me-2"
                 style="width: 32px; height: 32px;">
                <small class="fw-bold">@(AuthState.CurrentUser?.FullName?.Substring(0, 1) ?? "U")</small>
            </div>
            <div class="user-details flex-grow-1 overflow-hidden">
                <div class="user-name small fw-semibold text-truncate">@AuthState.CurrentUser?.FullName</div>
                <div class="user-role text-muted" style="font-size: 0.75rem;">@GetRoleDisplayName(AuthState.CurrentUser?.Role ?? UserRole.ReadOnly)</div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<bool> OnToggleExpanded { get; set; }
    [Parameter] public bool IsExpanded { get; set; } = true;

    private bool isFinancialReportsOpen = false;
    private bool collapseNavMenu = true;
    private bool isLoadingPermissions = true;

    // Permisos de acceso a módulos
    private bool hasCustomerAccess = false;
    private bool hasVehicleAccess = false;
    private bool hasRentalAccess = false;
    private bool hasPartnerAccess = false;
    private bool hasFinancialReportsAccess = false;
    private bool hasUserAccess = false;
    private bool hasPermissionAccess = false;
    private bool hasAuditAccess = false;

    private string NavMenuCssClass => collapseNavMenu ? "d-none d-md-block" : "d-block";

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await LoadModulePermissions();
        AuthState.OnAuthenticationStateChanged += StateHasChanged;
    }

    private async Task LoadModulePermissions()
    {
        if (!AuthState.IsAuthenticated)
        {
            isLoadingPermissions = false;
            return;
        }

        try
        {
            // Cargar permisos de acceso a módulos
            var customerResult = await PermissionApiClient.HasPermissionAsync("Customer", "Access");
            hasCustomerAccess = customerResult.IsSuccess && customerResult.Data;

            var vehicleResult = await PermissionApiClient.HasPermissionAsync("Vehicle", "Access");
            hasVehicleAccess = vehicleResult.IsSuccess && vehicleResult.Data;

            var rentalResult = await PermissionApiClient.HasPermissionAsync("Rental", "Access");
            hasRentalAccess = rentalResult.IsSuccess && rentalResult.Data;

            var partnerResult = await PermissionApiClient.HasPermissionAsync("Partner", "Access");
            hasPartnerAccess = partnerResult.IsSuccess && partnerResult.Data;

            var financialResult = await PermissionApiClient.HasPermissionAsync("FinancialReports", "Access");
            hasFinancialReportsAccess = financialResult.IsSuccess && financialResult.Data;

            var userResult = await PermissionApiClient.HasPermissionAsync("User", "Access");
            hasUserAccess = userResult.IsSuccess && userResult.Data;

            var permissionResult = await PermissionApiClient.HasPermissionAsync("Permission", "Access");
            hasPermissionAccess = permissionResult.IsSuccess && permissionResult.Data;

            var auditResult = await PermissionApiClient.HasPermissionAsync("Audit", "Access");
            hasAuditAccess = auditResult.IsSuccess && auditResult.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar permisos: {ex.Message}");
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task ToggleExpanded()
    {
        IsExpanded = !IsExpanded;

        if (!IsExpanded)
        {
            isFinancialReportsOpen = false;
        }

        await OnToggleExpanded.InvokeAsync(IsExpanded);
        StateHasChanged();
    }

    private void ToggleFinancialReportsMenu()
    {
        if (IsExpanded)
        {
            isFinancialReportsOpen = !isFinancialReportsOpen;
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthState.LogoutAsync();
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "currentUser");

            NavigationManager.NavigateTo("/login", forceLoad: true);
            ToastService.ShowSuccess("Sesión cerrada exitosamente");

            _ = Task.Run(async () =>
            {
                try
                {
                    await AuthApiClient.LogoutAsync();
                }
                catch { }
            });
        }
        catch (Exception ex)
        {
            await AuthState.LogoutAsync();
            await JSRuntime.InvokeVoidAsync("localStorage.clear");
            NavigationManager.NavigateTo("/login", forceLoad: true);
            ToastService.ShowError($"Sesión cerrada: {ex.Message}");
        }
    }

    private string GetRoleDisplayName(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => "Admin",
            UserRole.Manager => "Manager",
            UserRole.Employee => "Empleado",
            UserRole.ReadOnly => "Solo Lectura",
            _ => "Desconocido"
        };
    }

    public void Dispose()
    {
        AuthState.OnAuthenticationStateChanged -= StateHasChanged;
    }
}