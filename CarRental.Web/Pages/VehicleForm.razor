@page "/vehicles/add"
@page "/vehicles/edit/{Id:int}"

@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using CarRental.Web.Models
@using Blazored.Toast.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Globalization

@inject CarRental.Web.Services.VehicleApiClient VehicleApiClient
@inject CarRental.Web.Services.PartnerApiClient PartnerApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject HttpClient HttpClient

@if (isLoadingPermissions)
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center justify-center">
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando formulario...</p>
        </div>
    </div>
}
else if (!hasModuleAccess)
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center justify-center">
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <p class="text-gray-800 text-lg mb-2">Acceso no autorizado</p>
            <p class="text-gray-600 text-sm mb-4">No tienes acceso al módulo de Vehículos</p>
            <button @onclick="GoBackToList" class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">
                Volver al Inicio
            </button>
        </div>
    </div>
}
else if (!hasPermission)
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center justify-center">
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <p class="text-gray-800 text-lg mb-2">Acceso no autorizado</p>
            <p class="text-gray-600 text-sm mb-4">
                No tienes permisos para @(_isEditMode ? "editar" : "crear") vehículos
            </p>
            <button @onclick="GoBackToList" class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">
                Volver a la Lista
            </button>
        </div>
    </div>
}
else
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center">
        <div class="w-full max-w-2xl bg-white p-6 rounded-lg shadow-md">

            <h3 class="text-3xl font-bold text-center text-gray-800 mb-6">
                @(_isEditMode ? "Editar Vehículo" : "Agregar Nuevo Vehículo")
            </h3>

            <EditForm Model="@_vehicle" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if ((!_isEditMode && _createResponse != null && !_createResponse.IsSuccess) || (_isEditMode && _updateResponse != null && !_updateResponse.IsSuccess))
                {
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                        <strong class="font-bold">¡Error!</strong>
                        <span class="block">@(_isEditMode? _updateResponse?.ErrorMessage : _createResponse?.ErrorMessage)</span>
                    </div>
                }

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div class="form-group">
                        <label for="make" class="block text-sm font-medium text-gray-700 mb-1">Marca:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedMake" />
                        <ValidationMessage For="@(() => _vehicle.Make)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="model" class="block text-sm font-medium text-gray-700 mb-1">Modelo:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedModel" />
                        <ValidationMessage For="@(() => _vehicle.Model)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="type" class="block text-sm font-medium text-gray-700 mb-1">Tipo:</label>
                        <InputSelect id="type" class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_vehicle.Type">
                            @foreach (var type in Enum.GetValues<Vehicle.VehicleType>())
                            {
                                <option value="@type">@type.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _vehicle.Type)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="year" class="block text-sm font-medium text-gray-700 mb-1">Año:</label>
                        <InputNumber class="w-full p-3 border rounded" @bind-Value="_vehicle.Year" />
                        <ValidationMessage For="@(() => _vehicle.Year)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="vin" class="block text-sm font-medium text-gray-700 mb-1">
                            VIN (17 caracteres):
                        </label>
                        <input type="text"
                               id="vin"
                                   class="@($"w-full p-3 border rounded {GetVinBorderClass()}")"
                                   value="@_vehicle.Vin"
                                   @oninput="OnVinInput"
                                   maxlength="17" />
                        <div class="flex justify-between items-center mt-1">
                            <ValidationMessage For="@(() => _vehicle.Vin)" class="text-red-500 text-xs" />
                            <span class="@($"text-xs font-mono {GetVinCounterClass()}")">
                                @GetVinLength() / 17
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="color" class="block text-sm font-medium text-gray-700 mb-1">Color:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedColor" />
                        <ValidationMessage For="@(() => _vehicle.Color)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="licensePlate" class="block text-sm font-medium text-gray-700 mb-1">
                            Matrícula (AAA1234):
                        </label>
                        <input type="text"
                               id="licensePlate"
                               class="@($"w-full p-3 border rounded {GetLicensePlateBorderClass()}")"
                               value="@_vehicle.LicensePlate"
                               @oninput="OnLicensePlateInput"
                               maxlength="7"
                               placeholder="ABC1234"
                               style="text-transform: uppercase;" />
                        <div class="flex justify-between items-center mt-1">
                            <ValidationMessage For="@(() => _vehicle.LicensePlate)" class="text-red-500 text-xs" />
                            <span class="@($"text-xs {GetLicensePlateMessageClass()}")">
                                @GetLicensePlateMessage()
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="dailyRate" class="block text-sm font-medium text-gray-700 mb-1">Tarifa Diaria:</label>
                        <InputNumber class="w-full p-3 border rounded" @bind-Value="_vehicle.DailyRate" />
                        <ValidationMessage For="@(() => _vehicle.DailyRate)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="md:col-span-2">
                        <label for="state" class="block text-sm font-medium text-gray-700 mb-1">Estado:</label>
                        <InputSelect id="state" class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_vehicle.State">
                            @foreach (var state in Enum.GetValues<Vehicle.VehicleState>())
                            {
                                <option value="@state">@state.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _vehicle.State)" class="text-red-500 text-xs mt-1" />
                    </div>
                </div>

                <div class="mb-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                    <h4 class="text-lg font-semibold text-gray-800 mb-4">Propietario del Vehículo</h4>

                    <div class="mb-4">
                        <label for="ownershipType" class="block text-sm font-medium text-gray-700 mb-1">Pertenece a:</label>
                        <InputSelect id="ownershipType" class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                     @bind-Value="_vehicle.Ownership" @onchange="OnOwnershipTypeChanged">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var ownershipType in Enum.GetValues<Vehicle.OwnershipType>())
                            {
                                <option value="@ownershipType">@ownershipType.ToString()</option>
                            }
                        </InputSelect>
                    </div>

                    @if (_vehicle.Ownership == Vehicle.OwnershipType.Socio)
                    {
                        <div class="mb-4">
                            <label for="partnerId" class="block text-sm font-medium text-gray-700 mb-1">Seleccionar Socio:</label>
                            @if (_partners == null)
                            {
                                <div class="p-3 bg-gray-100 rounded text-gray-600">Cargando socios...</div>
                            }
                            else if (!_partners.Any())
                            {
                                <div class="p-3 bg-yellow-100 border border-yellow-400 text-yellow-700 rounded">
                                    No hay socios registrados.
                                    <a href="/partners/add" class="underline font-medium">Crear nuevo socio</a>
                                </div>
                            }
                            else
                            {
                                <InputSelect id="partnerId" class="w-full p-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                                             @bind-Value="_vehicle.PartnerId">
                                    <option value="">-- Seleccionar Socio --</option>
                                    @foreach (var partner in _partners)
                                    {
                                        <option value="@partner.Id">@($"{partner.FirstName} {partner.LastName} - {partner.DocumentNumber}")</option>
                                    }
                                </InputSelect>
                            }
                        </div>
                    }
                </div>

                @if (_isEditMode && _vehicle.ImageUrls != null && _vehicle.ImageUrls.Any())
                {
                    <div class="mt-4 mb-6">
                        <h4 class="text-xl font-bold text-gray-800 mb-3">Fotos Actuales:</h4>
                        <div class="flex flex-wrap gap-4">
                            @foreach (var imageUrl in _vehicle.ImageUrls)
                            {
                                <div class="relative w-40 h-28 rounded overflow-hidden shadow-md">
                                    <img src="@imageUrl" class="w-full h-full object-cover" />
                                    <button type="button" class="absolute top-1 right-1 bg-red-600 text-white rounded-full p-1 text-xs" @onclick="() => RemoveExistingImage(imageUrl)">X</button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="mb-6">
                    <label>Subir Fotos:</label>
                    <InputFile OnChange="OnInputFileChange" multiple class="w-full p-3 border rounded" />
                </div>

                @if (_selectedFiles.Any())
                {
                    <div class="mb-6 p-4 bg-blue-50 rounded border">
                        <strong class="block mb-2">Nuevos archivos seleccionados:</strong>
                        <ul class="list-disc list-inside">
                            @foreach (var file in _selectedFiles)
                            {
                                <li>@file.Name</li>
                            }
                        </ul>
                    </div>
                }

                <div class="flex justify-end space-x-4">
                    <button type="button" class="px-6 py-3 bg-gray-300 text-gray-800 rounded-md hover:bg-gray-400 transition duration-300 ease-in-out shadow-md font-semibold" @onclick="GoBackToList">Cancelar</button>
                    <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">
                        @(_isEditMode ? "Guardar Cambios" : "Guardar Vehículo")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Vehicle _vehicle = new();
    private List<IBrowserFile> _selectedFiles = new();
    private IEnumerable<Partner> _partners;

    private bool isLoadingPermissions = true;
    private bool hasModuleAccess = false;
    private bool hasPermission = false;

    private CarRental.Core.Models.ApiResult<Vehicle> _createResponse;
    private CarRental.Core.Models.ApiResult<bool> _updateResponse;

    private bool _isEditMode => Id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();

        if (!hasModuleAccess || !hasPermission)
        {
            isLoadingPermissions = false;
            return;
        }

        await LoadPartners();

        if (_isEditMode)
        {
            var result = await VehicleApiClient.GetVehicleByIdAsync(Id.Value);
            if (result.IsSuccess)
            {
                _vehicle = result.Data;
                _vehicle.ImageUrls ??= new List<string>();
            }
            else
            {
                ToastService.ShowError($"Error al cargar vehículo: {result.ErrorMessage}");
                NavigationManager.NavigateTo("/vehicles");
            }
        }

        isLoadingPermissions = false;
    }

    private async Task LoadPermissions()
    {
        try
        {
            var moduleAccessResult = await PermissionApiClient.HasPermissionAsync("Vehicle", "Access");
            hasModuleAccess = moduleAccessResult.IsSuccess && moduleAccessResult.Data;

            if (!hasModuleAccess)
            {
                return;
            }

            string requiredAction = _isEditMode ? "Edit" : "Create";
            var actionResult = await PermissionApiClient.HasPermissionAsync("Vehicle", requiredAction);
            hasPermission = actionResult.IsSuccess && actionResult.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al verificar permisos: {ex.Message}");
            hasModuleAccess = false;
            hasPermission = false;
        }
    }

    private async Task LoadPartners()
    {
        try
        {
            var result = await PartnerApiClient.GetPartnersAsync();
            if (result.IsSuccess)
            {
                _partners = result.Data;
            }
            else
            {
                _partners = new List<Partner>();
                ToastService.ShowWarning("No se pudieron cargar los socios.");
            }
        }
        catch (Exception ex)
        {
            _partners = new List<Partner>();
            ToastService.ShowError($"Error al cargar socios: {ex.Message}");
        }
    }

    private string FormattedMake
    {
        get => _vehicle.Make;
        set => _vehicle.Make = CapitalizeEachWord(value);
    }

    private string FormattedModel
    {
        get => _vehicle.Model;
        set => _vehicle.Model = CapitalizeEachWord(value);
    }

    private string FormattedColor
    {
        get => _vehicle.Color;
        set => _vehicle.Color = CapitalizeEachWord(value);
    }

    private string FormattedVin
    {
        get => _vehicle.Vin;
        set
        {
            var cleaned = value?.ToUpper().Trim() ?? "";
            if (cleaned.Length > 17) cleaned = cleaned.Substring(0, 17);
            _vehicle.Vin = cleaned;
        }
    }

    private string FormattedLicensePlate
    {
        get => _vehicle.LicensePlate;
        set
        {
            var cleaned = value?.ToUpper().Trim() ?? "";
            if (cleaned.Length > 6) cleaned = cleaned.Substring(0, 6);
            _vehicle.LicensePlate = cleaned;
        }
    }

    private async Task OnOwnershipTypeChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() != Vehicle.OwnershipType.Socio.ToString())
        {
            _vehicle.PartnerId = null;
        }

        if (e.Value?.ToString() == Vehicle.OwnershipType.Socio.ToString() && (_partners == null || !_partners.Any()))
        {
            await LoadPartners();
        }

        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (_vehicle.Ownership == Vehicle.OwnershipType.Socio && !_vehicle.PartnerId.HasValue)
        {
            ToastService.ShowError("Debe seleccionar un socio cuando el vehículo pertenece a un socio.");
            return;
        }

        if (_vehicle.Ownership != Vehicle.OwnershipType.Socio)
        {
            _vehicle.PartnerId = null;
        }

        if (_selectedFiles.Any())
        {
            var uploadedImageUrls = await UploadFilesToApi(_selectedFiles);
            if (uploadedImageUrls != null)
            {
                _vehicle.ImageUrls.AddRange(uploadedImageUrls);
            }
            else
            {
                ToastService.ShowError("Error al subir las imágenes.");
                return;
            }
        }

        if (_isEditMode)
        {
            var updateDto = new VehicleForUpdateDto
            {
                Id = _vehicle.Id,
                Make = _vehicle.Make,
                Model = _vehicle.Model,
                Type = _vehicle.Type,
                Year = _vehicle.Year,
                LicensePlate = _vehicle.LicensePlate,
                DailyRate = _vehicle.DailyRate,
                State = _vehicle.State,
                Vin = _vehicle.Vin,
                Color = _vehicle.Color,
                ImageUrls = _vehicle.ImageUrls,
                Ownership = _vehicle.Ownership,
                PartnerId = _vehicle.PartnerId
            };

            _updateResponse = await VehicleApiClient.UpdateVehicleAsync(updateDto);
            if (_updateResponse.IsSuccess)
            {
                ToastService.ShowSuccess("Vehículo actualizado con éxito.");
                NavigationManager.NavigateTo("/vehicles");
            }
            else
            {
                ToastService.ShowError(_updateResponse.ErrorMessage);
            }
        }
        else
        {
            var dto = new VehicleForCreationDto
            {
                Make = _vehicle.Make,
                Model = _vehicle.Model,
                Type = _vehicle.Type,
                Year = _vehicle.Year,
                LicensePlate = _vehicle.LicensePlate,
                DailyRate = _vehicle.DailyRate,
                State = _vehicle.State,
                Vin = _vehicle.Vin,
                Color = _vehicle.Color,
                ImageUrls = _vehicle.ImageUrls,
                Ownership = _vehicle.Ownership,
                PartnerId = _vehicle.PartnerId
            };

            _createResponse = await VehicleApiClient.AddVehicleAsync(dto);
            if (_createResponse.IsSuccess)
            {
                ToastService.ShowSuccess("Vehículo creado con éxito.");
                NavigationManager.NavigateTo("/vehicles");
            }
            else
            {
                ToastService.ShowError(_createResponse.ErrorMessage);
            }
        }
    }

    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        _selectedFiles.Clear();
        _selectedFiles.AddRange(e.GetMultipleFiles());
    }

    private void RemoveExistingImage(string imageUrl)
    {
        _vehicle.ImageUrls.Remove(imageUrl);
    }

    private async Task<List<string>> UploadFilesToApi(List<IBrowserFile> files)
    {
        using var content = new MultipartFormDataContent();
        foreach (var file in files)
        {
            var fileContent = new StreamContent(file.OpenReadStream(file.Size));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "files", file.Name);
        }

        var response = await HttpClient.PostAsync("api/Files/upload/vehicle-images", content);
        if (response.IsSuccessStatusCode)
        {
            return await response.Content.ReadFromJsonAsync<List<string>>();
        }
        return null;
    }

    private string CapitalizeEachWord(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        TextInfo textInfo = new CultureInfo("es-ES", false).TextInfo;
        return textInfo.ToTitleCase(input.ToLower());
    }

    private void GoBackToList()
    {
        NavigationManager.NavigateTo("/vehicles");
    }

    private void OnVinInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        var cleaned = value.ToUpper().Trim();
        if (cleaned.Length > 17) cleaned = cleaned.Substring(0, 17);
        _vehicle.Vin = cleaned;
        StateHasChanged();
    }

    private int GetVinLength()
    {
        return string.IsNullOrEmpty(_vehicle.Vin) ? 0 : _vehicle.Vin.Length;
    }

    private string GetVinCounterClass()
    {
        var length = GetVinLength();
        if (length == 0) return "text-gray-400";
        else if (length < 17) return "text-orange-500 font-semibold";
        else return "text-green-600 font-semibold";
    }

    private string GetVinBorderClass()
    {
        var length = GetVinLength();
        if (length == 0) return "border-gray-300 focus:border-blue-500";
        else if (length < 17) return "border-orange-400 focus:border-orange-500";
        else return "border-green-500 focus:border-green-600";
    }

    private void OnLicensePlateInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        var cleaned = value.ToUpper().Trim();
        if (cleaned.Length > 7) cleaned = cleaned.Substring(0, 7);
        _vehicle.LicensePlate = cleaned;
        StateHasChanged();
    }

    private bool IsValidLicensePlateFormat()
    {
        if (string.IsNullOrEmpty(_vehicle.LicensePlate))
            return false;

        var cleaned = _vehicle.LicensePlate.Trim();

        // Debe tener exactamente 7 caracteres
        if (cleaned.Length != 7)
            return false;

        // Primeros 3 deben ser letras
        for (int i = 0; i < 3; i++)
        {
            if (!char.IsLetter(cleaned[i]))
                return false;
        }

        // Últimos 3 deben ser números
        for (int i = 3; i < 7; i++)
        {
            if (!char.IsDigit(cleaned[i]))
                return false;
        }

        return true;
    }

    /// Obtiene el mensaje de validación para la placa

    private string GetLicensePlateMessage()
    {
        if (string.IsNullOrEmpty(_vehicle.LicensePlate))
            return "Formato: AAA1234";

        var length = _vehicle.LicensePlate.Length;

        if (length < 7)
            return $"{length}/7 caracteres";

        if (IsValidLicensePlateFormat())
            return "✓ Formato válido";

        // Validar qué parte está mal
        if (length >= 3)
        {
            bool lettersOk = true;
            for (int i = 0; i < 3; i++)
            {
                if (!char.IsLetter(_vehicle.LicensePlate[i]))
                {
                    lettersOk = false;
                    break;
                }
            }

            if (!lettersOk)
                return "⚠ Primeros 3 deben ser letras";
        }

        if (length == 7)
        {
            bool numbersOk = true;
            for (int i = 3; i < 7; i++)
            {
                if (!char.IsDigit(_vehicle.LicensePlate[i]))
                {
                    numbersOk = false;
                    break;
                }
            }

            if (!numbersOk)
                return "⚠ Últimos 4 deben ser números";
        }

        return "Formato: AAA1234";
    }

    /// Obtiene la clase CSS para el mensaje según el estado

    private string GetLicensePlateMessageClass()
    {
        if (string.IsNullOrEmpty(_vehicle.LicensePlate))
            return "text-gray-400";

        if (IsValidLicensePlateFormat())
            return "text-green-600 font-semibold";

        if (_vehicle.LicensePlate.Length < 7)
            return "text-gray-500";

        return "text-red-500 font-semibold";
    }

    /// Obtiene la clase CSS para el borde del input según el estado

    private string GetLicensePlateBorderClass()
    {
        if (string.IsNullOrEmpty(_vehicle.LicensePlate))
            return "border-gray-300 focus:border-blue-500";

        if (IsValidLicensePlateFormat())
            return "border-green-500 focus:border-green-600";

        if (_vehicle.LicensePlate.Length < 7)
            return "border-blue-400 focus:border-blue-500";

        return "border-red-500 focus:border-red-600";
    }


}