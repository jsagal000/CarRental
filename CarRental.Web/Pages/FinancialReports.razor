    private async Task ExportToPdf()
    {
        if (companyPerspectiveReport?.Any() != true)
        {
            ToastService.ShowWarning("No hay datos para exportar.");
            return;
        }

        isExporting = true;
        exportType = "PDF";

        try
        {
            var htmlContent = GenerateHtmlForExport();
            await JSRuntime.InvokeVoidAsync("printReport", htmlContent);
            ToastService.ShowSuccess("Reporte PDF abierto para imprimir.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al exportar a PDF: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            exportType = "";
        }
    }


    private async Task ExportToExcel()
    {
        if (companyPerspectiveReport?.Any() != true)
        {
            ToastService.ShowWarning("No hay datos para exportar.");
            return;
        }

        isExporting = true;
        exportType = "Excel";

        try
        {
            var csvContent = GenerateCsvContent();
            await JSRuntime.InvokeVoidAsync("downloadFile", csvContent, $"Reporte_Financiero_{StartDate:yyyy-MM-dd}_a_{EndDate:yyyy-MM-dd}.csv", "text/csv");
            ToastService.ShowSuccess("Reporte Excel generado exitosamente.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al exportar a Excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            exportType = "";
        }
    }
