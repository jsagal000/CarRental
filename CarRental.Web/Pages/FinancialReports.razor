    private string GenerateCsvContent()
    {
        var csv = new System.Text.StringBuilder();

        csv.AppendLine($"Reporte Financiero - Período: {StartDate:dd/MM/yyyy} - {EndDate:dd/MM/yyyy}");
        csv.AppendLine();

        if (companyPerspectiveReport?.Any() == true)
        {
            csv.AppendLine("INGRESOS DE LA EMPRESA");
            csv.AppendLine("Vehículo,Propiedad,Cálculo Proporcional,Ingreso Bruto,Mantenimiento,Reparaciones,Seguros,Total Gastos,Ingreso Total Empresa");

            foreach (var item in companyPerspectiveReport)
            {
                csv.AppendLine($"\"{item.VehiculoInfo}\",\"{(item.EsVehiculoEmpresa ? "Empresa" : "Socio")}\",\"{(item.TieneCalculoProporcional ? "Sí" : "No")}\",{item.IngresoBruto},{item.CostoMantenimiento},{item.CostoReparaciones},{item.CostoSeguros},{item.TotalGastos},{item.IngresoTotalEmpresa}");
            }

            var totalIngresosBrutos = companyPerspectiveReport.Sum(x => x.IngresoBruto);
            var totalMantenimiento = companyPerspectiveReport.Sum(x => x.CostoMantenimiento);
            var totalReparaciones = companyPerspectiveReport.Sum(x => x.CostoReparaciones);
            var totalSeguros = companyPerspectiveReport.Sum(x => x.CostoSeguros);
            var totalGastos = companyPerspectiveReport.Sum(x => x.TotalGastos);
            var totalIngresoEmpresa = companyPerspectiveReport.Sum(x => x.IngresoTotalEmpresa);

            csv.AppendLine($"\"TOTAL EMPRESA\",\"\",\"\",{totalIngresosBrutos},{totalMantenimiento},{totalReparaciones},{totalSeguros},{totalGastos},{totalIngresoEmpresa}");
            csv.AppendLine();
        }

        if (partnerDetailReport?.Any() == true)
        {
            csv.AppendLine("DETALLE PARA SOCIOS (70% - 30%)");
            csv.AppendLine("Vehículo,Socio,Cálculo Proporcional,Ingreso Bruto,Total Gastos,Admin. Empresa (30%),Ingreso Total Socio");

            foreach (var item in partnerDetailReport)
            {
                csv.AppendLine($"\"{item.VehiculoInfo}\",\"{item.NombreSocio}\",\"{(item.TieneCalculoProporcional ? "Sí" : "No")}\",{item.IngresoBrutoSocio},{item.TotalGastos},{item.AdministracionEmpresa},{item.IngresoTotalSocio}");
            }

            var totalIngresosBrutosSocios = partnerDetailReport.Sum(x => x.IngresoBrutoSocio);
            var totalGastosSocios = partnerDetailReport.Sum(x => x.TotalGastos);
            var totalAdministracion = partnerDetailReport.Sum(x => x.AdministracionEmpresa);
            var totalIngresoSocios = partnerDetailReport.Sum(x => x.IngresoTotalSocio);

            csv.AppendLine($"\"TOTAL SOCIOS\",\"\",\"\",{totalIngresosBrutosSocios},{totalGastosSocios},{totalAdministracion},{totalIngresoSocios}");
        }

        return csv.ToString();
    }

