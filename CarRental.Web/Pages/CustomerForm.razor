@page "/customers/add"
@page "/customers/edit/{Id:int}"

@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using CarRental.Web.Models
@using Blazored.Toast.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

@inject CarRental.Web.Services.CustomerApiClient CustomerApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject IToastService ToastService

@if (isLoadingPermissions)
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center justify-center">
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Cargando formulario...</p>
        </div>
    </div>
}
else if (!hasModuleAccess)
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center justify-center">
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <div class="mb-4">
                <svg class="w-20 h-20 text-red-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Acceso Denegado</h2>
            <p class="text-gray-600 mb-4">No tienes acceso al módulo de Clientes.</p>
            <button @onclick="GoBackToList" class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">
                Volver al Inicio
            </button>
        </div>
    </div>
}
else if (!hasPermission)
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center justify-center">
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
            <div class="mb-4">
                <svg class="w-16 h-16 text-orange-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 18.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">Permiso Insuficiente</h2>
            <p class="text-gray-600 mb-4">
                No tienes permisos para @(_isEditMode ? "editar" : "crear") clientes.
            </p>
            <button @onclick="GoBackToList" class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">
                Volver a la Lista
            </button>
        </div>
    </div>
}
else
{
    <div class="min-h-screen bg-gray-100 p-4 font-sans flex flex-col items-center">
        <div class="w-full max-w-2xl bg-white p-6 rounded-lg shadow-md">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-3xl font-bold text-gray-800">
                    @(_isEditMode ? "Editar Cliente" : "Agregar Nuevo Cliente")
                </h3>
                @if (!_isEditMode)
                {
                    <button type="button"
                        @onclick="ClearForm"
                        class="text-blue-600 hover:text-blue-800 underline text-sm font-medium">
                        Limpiar formulario
                    </button>
                }
            </div>
            <EditForm Model="@_customer" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if ((!_isEditMode && _createResponse != null && !_createResponse.IsSuccess) || (_isEditMode && _updateResponse != null && !_updateResponse.IsSuccess))
                {
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                        <strong class="font-bold">¡Error!</strong>
                        <span class="block">@(_isEditMode? _updateResponse?.ErrorMessage : _createResponse?.ErrorMessage)</span>
                    </div>
                }

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div class="form-group">
                        <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">Nombres:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedFirstName" />
                        <ValidationMessage For="@(() => _customer.FirstName)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Apellidos:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedLastName" />
                        <ValidationMessage For="@(() => _customer.LastName)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="nationality" class="block text-sm font-medium text-gray-700 mb-1">
                            Nacionalidad:
                        </label>
                        <InputText class="w-full p-3 border rounded"
                                   @bind-Value="FormattedNationality"
                                   placeholder="Ej: Ecuatoriana, Colombiana" />
                        <ValidationMessage For="@(() => _customer.Nationality)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="typeOfDocument" class="block text-sm font-medium text-gray-700 mb-1">Tipo de Documento:</label>
                        <InputSelect class="w-full p-3 border rounded"
                                     @bind-Value="_customer.TypeOfDocument"
                                     @bind-Value:after="OnDocumentTypeChanged">
                            @foreach (var docType in Enum.GetValues<Customer.DocumentType>())
                            {
                                <option value="@docType">@docType.ToString()</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _customer.TypeOfDocument)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="documentNumber" class="block text-sm font-medium text-gray-700 mb-1">
                            Número de Documento:
                        </label>
                        <input type="text"
                               id="documentNumber"
                               class="@($"w-full p-3 border rounded {GetDocumentNumberBorderClass()}")"
                               value="@_customer.DocumentNumber"
                               @oninput="OnDocumentNumberInput"
                               maxlength="@GetDocumentNumberMaxLength()"
                               placeholder="@GetDocumentNumberPlaceholder()"
                               style="text-transform: uppercase;" />
                        <div class="flex justify-between items-center mt-1">
                            <div class="flex-1">
                                <ValidationMessage For="@(() => _customer.DocumentNumber)" class="text-red-500 text-xs" />
                                @if (!string.IsNullOrEmpty(documentNumberErrorMessage))
                                {
                                    <span class="text-red-500 text-xs block">@documentNumberErrorMessage</span>
                                }
                                @if (!string.IsNullOrEmpty(duplicateCustomerMessage))
                                {
                                    <span class="text-orange-600 text-xs font-semibold block mt-1">@duplicateCustomerMessage</span>
                                }
                                @if (isCheckingDuplicate)
                                {
                                    <span class="text-blue-500 text-xs block mt-1">
                                        <span class="inline-block animate-spin mr-1">⚙️</span> Verificando...
                                    </span>
                                }
                            </div>
                            <span class="@($"text-xs {GetDocumentNumberMessageClass()}")">
                                @GetDocumentNumberMessage()
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="dateOfBirth" class="block text-sm font-medium text-gray-700 mb-1">Fecha de Nacimiento:</label>
                        <InputDate class="w-full p-3 border rounded" @bind-Value="_customer.DateOfBirth" />
                        <ValidationMessage For="@(() => _customer.DateOfBirth)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email:</label>
                        <InputText type="email" class="w-full p-3 border rounded" @bind-Value="_customer.Email" />
                        <ValidationMessage For="@(() => _customer.Email)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="phoneNumber" class="block text-sm font-medium text-gray-700 mb-1">
                            Teléfono:
                        </label>
                        <input type="text"
                               id="phoneNumber"
                               class="@($"w-full p-3 border rounded {GetPhoneBorderClass()}")"
                               value="@_customer.PhoneNumber"
                               @oninput="OnPhoneNumberInput"
                               maxlength="@GetPhoneNumberMaxLength()"
                               placeholder="@GetPhonePlaceholder()" />
                        <div class="flex justify-between items-center mt-1">
                            <div class="flex-1">
                                <ValidationMessage For="@(() => _customer.PhoneNumber)" class="text-red-500 text-xs" />
                                @if (!string.IsNullOrEmpty(phoneNumberErrorMessage))
                                {
                                    <span class="text-red-500 text-xs">@phoneNumberErrorMessage</span>
                                }
                            </div>
                            <span class="@($"text-xs {GetPhoneMessageClass()}")">
                                @GetPhoneMessage()
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="country" class="block text-sm font-medium text-gray-700 mb-1">País:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedCountry" />
                        <ValidationMessage For="@(() => _customer.Country)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="stateProvince" class="block text-sm font-medium text-gray-700 mb-1">Estado/Provincia:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedStateProvince" />
                        <ValidationMessage For="@(() => _customer.StateProvince)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group">
                        <label for="city" class="block text-sm font-medium text-gray-700 mb-1">Ciudad:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedCity" />
                        <ValidationMessage For="@(() => _customer.City)" class="text-red-500 text-xs mt-1" />
                    </div>
                    <div class="form-group md:col-span-2">
                        <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Dirección:</label>
                        <InputText class="w-full p-3 border rounded" @bind-Value="FormattedAddress" />
                        <ValidationMessage For="@(() => _customer.Address)" class="text-red-500 text-xs mt-1" />
                    </div>
                </div>

                <div class="flex justify-end space-x-4 pt-6">
                    <button type="button" class="px-6 py-3 bg-gray-300 text-gray-800 rounded-md hover:bg-gray-400 transition duration-300 ease-in-out shadow-md font-semibold" @onclick="GoBackToList">Cancelar</button>
                    <button type="submit" class="px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">
                        @(_isEditMode ? "Guardar Cambios" : "Guardar Cliente")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Customer _customer = new();
    private ApiResult<Customer> _createResponse;
    private ApiResult<bool> _updateResponse;

    private bool isLoadingPermissions = true;
    private bool hasModuleAccess = false;
    private bool hasPermission = false;

    private bool _isEditMode => Id.HasValue;

    private string documentNumberErrorMessage = "";
    private string phoneNumberErrorMessage = "";
    private System.Threading.Timer? documentErrorTimer;
    private System.Threading.Timer? phoneErrorTimer;
    // Variables para validación de cliente duplicado
    private string duplicateCustomerMessage = "";
    private bool isCheckingDuplicate = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();

        if (!hasModuleAccess || !hasPermission)
        {
            isLoadingPermissions = false;
            return;
        }

        if (_isEditMode)
        {
            var result = await CustomerApiClient.GetCustomerByIdAsync(Id.Value);
            if (result.IsSuccess)
            {
                _customer = result.Data;
            }
            else
            {
                ToastService.ShowError($"Error al cargar cliente: {result.ErrorMessage}");
                NavigationManager.NavigateTo("/customers");
            }
        }
        else
        {
            _customer.TypeOfDocument = Customer.DocumentType.Cédula;
        }

        isLoadingPermissions = false;
    }

    private async Task LoadPermissions()
    {
        try
        {
            // 1. Verificar acceso al módulo Customer
            var moduleAccessResult = await PermissionApiClient.HasPermissionAsync("Customer", "Access");
            hasModuleAccess = moduleAccessResult.IsSuccess && moduleAccessResult.Data;

            if (!hasModuleAccess)
            {
                return;
            }

            // 2. Verificar permiso específico según el modo
            string requiredAction = _isEditMode ? "Edit" : "Create";
            var actionResult = await PermissionApiClient.HasPermissionAsync("Customer", requiredAction);
            hasPermission = actionResult.IsSuccess && actionResult.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al verificar permisos: {ex.Message}");
            hasModuleAccess = false;
            hasPermission = false;
        }
    }

    private string FormattedFirstName
    {
        get => _customer.FirstName;
        set => _customer.FirstName = CapitalizeEachWord(value);
    }

    private string FormattedLastName
    {
        get => _customer.LastName;
        set => _customer.LastName = CapitalizeEachWord(value);
    }

    private string FormattedNationality
    {
        get => _customer.Nationality;
        set => _customer.Nationality = CapitalizeEachWord(value);
    }

    /// Verifica si el cliente es de nacionalidad ecuatoriana
    private bool IsEcuadorian()
    {
        if (string.IsNullOrWhiteSpace(_customer.Nationality))
            return false;

        var nationality = _customer.Nationality.Trim().ToLower();
        return nationality == "ecuatoriana" || nationality == "ecuatoriano";
    }

    private string FormattedAddress
    {
        get => _customer.Address;
        set => _customer.Address = CapitalizeEachWord(value);
    }

    private string FormattedCity
    {
        get => _customer.City;
        set => _customer.City = CapitalizeEachWord(value);
    }

    private string FormattedStateProvince
    {
        get => _customer.StateProvince;
        set => _customer.StateProvince = CapitalizeEachWord(value);
    }

    private string FormattedCountry
    {
        get => _customer.Country;
        set => _customer.Country = CapitalizeEachWord(value);
    }

    private async Task HandleSubmit()
    {
        // ✅ VALIDAR DUPLICADO ANTES DE GUARDAR
        if (!string.IsNullOrEmpty(duplicateCustomerMessage))
        {
            ToastService.ShowError("No se puede guardar: Ya existe un cliente con este número de documento.");
            return;
        }

        if (_isEditMode)
        {
            _updateResponse = await CustomerApiClient.UpdateCustomerAsync(_customer);
            if (_updateResponse.IsSuccess)
            {
                ToastService.ShowSuccess("Cliente actualizado con éxito.");
                NavigationManager.NavigateTo("/customers");
            }
            else
            {
                ToastService.ShowError(_updateResponse.ErrorMessage);
            }
        }
        else
        {
            // ✅ VERIFICAR UNA ÚLTIMA VEZ ANTES DE CREAR
            await CheckDuplicateCustomer();

            if (!string.IsNullOrEmpty(duplicateCustomerMessage))
            {
                ToastService.ShowError("No se puede crear: Ya existe un cliente con este número de documento.");
                return;
            }

            var dto = new CustomerForCreationDto
            {
                FirstName = _customer.FirstName,
                LastName = _customer.LastName,
                Nationality = _customer.Nationality,
                TypeOfDocument = _customer.TypeOfDocument,
                DocumentNumber = _customer.DocumentNumber,
                DateOfBirth = _customer.DateOfBirth,
                Email = _customer.Email,
                PhoneNumber = _customer.PhoneNumber,
                Country = _customer.Country,
                StateProvince = _customer.StateProvince,
                City = _customer.City,
                Address = _customer.Address
            };

            _createResponse = await CustomerApiClient.AddCustomerAsync(dto);
            if (_createResponse.IsSuccess)
            {
                ToastService.ShowSuccess("Cliente agregado con éxito.");
                NavigationManager.NavigateTo("/customers");
            }
            else
            {
                ToastService.ShowError(_createResponse.ErrorMessage);
            }
        }
    }

    private string CapitalizeEachWord(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        TextInfo textInfo = new CultureInfo("es-ES", false).TextInfo;
        return textInfo.ToTitleCase(input.ToLower());
    }

    private void GoBackToList()
    {
        NavigationManager.NavigateTo("/customers");
    }

    private void ClearForm()
    {
        // Limpiar el objeto customer
        _customer = new Customer();

        // Limpiar mensajes de error
        documentNumberErrorMessage = "";
        phoneNumberErrorMessage = "";
        duplicateCustomerMessage = "";

        // Limpiar respuestas
        _createResponse = null;

        // Forzar actualización de la UI
        StateHasChanged();

        // Mostrar mensaje de confirmación (opcional)
        ToastService.ShowInfo("Formulario limpiado");
    }
    // ============================================================================
    // MÉTODOS PARA VALIDACIÓN DE NÚMERO DE DOCUMENTO
    // ============================================================================

    /// Se ejecuta cuando cambia el tipo de documento
    private void OnDocumentTypeChanged()
    {
        // Limpiar mensaje de error
        documentNumberErrorMessage = "";
        StateHasChanged();
    }

    /// Verifica si ya existe un cliente con el mismo número de documento
    private async Task CheckDuplicateCustomer()
    {
        duplicateCustomerMessage = "";

        if (string.IsNullOrEmpty(_customer.DocumentNumber))
        {
            return;
        }

        try
        {
            isCheckingDuplicate = true;
            StateHasChanged();

            var customersResult = await CustomerApiClient.GetAllCustomersAsync();

            if (customersResult.IsSuccess && customersResult.Data != null)
            {
                var existingCustomer = customersResult.Data.FirstOrDefault(c =>
                    c.DocumentNumber == _customer.DocumentNumber &&
                    (_isEditMode ? c.Id != _customer.Id : true)
                );

                if (existingCustomer != null)
                {
                    duplicateCustomerMessage = $"⚠️ Ya existe un cliente registrado con el documento {_customer.DocumentNumber}: {existingCustomer.FirstName} {existingCustomer.LastName}";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al verificar cliente duplicado: {ex.Message}");
        }
        finally
        {
            isCheckingDuplicate = false;
            StateHasChanged();
        }
    }

    /// Maneja el input del número de documento según el tipo
    private async Task OnDocumentNumberInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString()?.ToUpper() ?? "";

        // Limpiar según tipo de documento
        if (_customer.TypeOfDocument == Customer.DocumentType.Pasaporte)
        {
            // Pasaporte: alfanumérico
            var cleaned = new string(value.Where(c => char.IsLetterOrDigit(c)).ToArray());
            _customer.DocumentNumber = cleaned;
        }
        else
        {
            // Cédula y RUC: solo números
            var cleaned = new string(value.Where(char.IsDigit).ToArray());

            // ============ VALIDACIÓN PARA ECUATORIANOS ============
            if (IsEcuadorian())
            {
                if (_customer.TypeOfDocument == Customer.DocumentType.Cédula)
                {
                    // El maxlength ya limita a 10, solo validar si está completo
                    if (!string.IsNullOrEmpty(cleaned) && cleaned.Length < 10)
                    {
                        ShowDocumentError($"⚠ Cédula debe tener 10 dígitos (actual: {cleaned.Length})");
                    }
                    else if (cleaned.Length == 10)
                    {
                        documentNumberErrorMessage = "";
                    }
                }
                else if (_customer.TypeOfDocument == Customer.DocumentType.RUC)
                {
                    // El maxlength ya limita a 13, solo validar si está completo
                    if (!string.IsNullOrEmpty(cleaned) && cleaned.Length < 13)
                    {
                        ShowDocumentError($"⚠ RUC debe tener 13 dígitos (actual: {cleaned.Length})");
                    }
                    else if (cleaned.Length == 13)
                    {
                        documentNumberErrorMessage = "";
                    }
                }
            }
            else
            {
                documentNumberErrorMessage = "";
            }

            _customer.DocumentNumber = cleaned;
        }

        // Verificar duplicados solo si el documento está completo
        bool shouldCheckDuplicate = false;

        if (IsEcuadorian())
        {
            shouldCheckDuplicate = (_customer.TypeOfDocument == Customer.DocumentType.Cédula && _customer.DocumentNumber?.Length == 10) ||
                                 (_customer.TypeOfDocument == Customer.DocumentType.RUC && _customer.DocumentNumber?.Length == 13) ||
                                 (_customer.TypeOfDocument == Customer.DocumentType.Pasaporte && !string.IsNullOrEmpty(_customer.DocumentNumber) && _customer.DocumentNumber.Length >= 5);
        }
        else
        {
            shouldCheckDuplicate = !string.IsNullOrEmpty(_customer.DocumentNumber) && _customer.DocumentNumber.Length >= 5;
        }

        if (shouldCheckDuplicate && !_isEditMode)
        {
            await CheckDuplicateCustomer();
        }
        else
        {
            duplicateCustomerMessage = "";
        }

        StateHasChanged();
    }



    /// Muestra mensaje de error temporal para documento
    private void ShowDocumentError(string message)
    {
        documentNumberErrorMessage = message;

        // Cancelar timer anterior si existe
        documentErrorTimer?.Dispose();

        // Crear nuevo timer para ocultar mensaje después de 3 segundos
        documentErrorTimer = new System.Threading.Timer(_ =>
        {
            documentNumberErrorMessage = "";
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    /// Obtiene el placeholder según el tipo de documento
    private string GetDocumentNumberPlaceholder()
    {
        if (IsEcuadorian())
        {
            return _customer.TypeOfDocument switch
            {
                Customer.DocumentType.Cédula => "10 dígitos (Ej: 1234567890)",
                Customer.DocumentType.RUC => "13 dígitos (Ej: 1234567890001)",
                Customer.DocumentType.Pasaporte => "Ej: AB123456",
                _ => "Número de documento"
            };
        }
        else
        {
            return _customer.TypeOfDocument switch
            {
                Customer.DocumentType.Cédula => "Ej: 1234567890",
                Customer.DocumentType.RUC => "Ej: 1234567890001",
                Customer.DocumentType.Pasaporte => "Ej: AB123456",
                _ => "Número de documento"
            };
        }
    }

    private int GetDocumentNumberMaxLength()
    {
        if (IsEcuadorian())
        {
            return _customer.TypeOfDocument switch
            {
                Customer.DocumentType.Cédula => 10,   // Máximo 10 dígitos
                Customer.DocumentType.RUC => 13,      // Máximo 13 dígitos
                Customer.DocumentType.Pasaporte => 20, // Pasaportes varían
                _ => 50
            };
        }
        else
        {
            // Para extranjeros: sin límite estricto
            return 50;
        }
    } 

    /// Obtiene el mensaje de validación para el número de documento
    private string GetDocumentNumberMessage()
    {
        if (string.IsNullOrEmpty(_customer.DocumentNumber))
            return "";

        if (IsEcuadorian())
        {
            return _customer.TypeOfDocument switch
            {
                Customer.DocumentType.Cédula => _customer.DocumentNumber.Length == 10 ? "✓ 10 dígitos" : $"⚠ {10 - _customer.DocumentNumber.Length} faltan",
                Customer.DocumentType.RUC => _customer.DocumentNumber.Length == 13 ? "✓ 13 dígitos" : $"⚠ {13 - _customer.DocumentNumber.Length} faltan",
                Customer.DocumentType.Pasaporte => "✓ Alfanumérico",
                _ => "✓"
            };
        }
        else
        {
            return _customer.TypeOfDocument switch
            {
                Customer.DocumentType.Cédula => "✓ Solo números",
                Customer.DocumentType.RUC => "✓ Solo números",
                Customer.DocumentType.Pasaporte => "✓ Alfanumérico",
                _ => "✓"
            };
        }
    }

    /// Obtiene la clase CSS para el mensaje de documento
    private string GetDocumentNumberMessageClass()
    {
        if (string.IsNullOrEmpty(_customer.DocumentNumber))
            return "text-gray-400";

        if (!string.IsNullOrEmpty(documentNumberErrorMessage))
            return "text-gray-400";

        return "text-green-600 font-semibold";
    }

    /// Obtiene la clase CSS para el borde del input de documento
    private string GetDocumentNumberBorderClass()
    {
        if (!string.IsNullOrEmpty(documentNumberErrorMessage))
            return "border-red-500 focus:border-red-600";

        if (!string.IsNullOrEmpty(duplicateCustomerMessage))
            return "border-orange-500 focus:border-orange-600";

        if (string.IsNullOrEmpty(_customer.DocumentNumber))
            return "border-gray-300 focus:border-blue-500";

        // Para ecuatorianos: verificar longitud exacta
        if (IsEcuadorian())
        {
            bool isValid = (_customer.TypeOfDocument == Customer.DocumentType.Cédula && _customer.DocumentNumber.Length == 10) ||
                          (_customer.TypeOfDocument == Customer.DocumentType.RUC && _customer.DocumentNumber.Length == 13) ||
                          (_customer.TypeOfDocument == Customer.DocumentType.Pasaporte);

            return isValid ? "border-green-500 focus:border-green-600" : "border-yellow-500 focus:border-yellow-600";
        }

        return "border-green-500 focus:border-green-600";
    }

    // ============================================================================
    // MÉTODOS PARA VALIDACIÓN DE TELÉFONO
    // ============================================================================


    /// Maneja el input del teléfono
    /// Solo permite números y el signo +
    private void OnPhoneNumberInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";

        // Permitir solo números y + (para extranjeros)
        var cleaned = new string(value.Where(c => char.IsDigit(c) || c == '+').ToArray());

        // ============ VALIDACIÓN PARA ECUATORIANOS ============
        if (IsEcuadorian())
        {
            // Eliminar + si lo tiene (no permitido para ecuatorianos)
            if (cleaned.StartsWith("+"))
            {
                ShowPhoneError("⚠ Teléfonos ecuatorianos no usan código de país (+)");
                cleaned = cleaned.Replace("+", "");
            }

            // El maxlength ya limita a 10, solo validar si está completo
            if (!string.IsNullOrEmpty(cleaned) && cleaned.Length < 10)
            {
                ShowPhoneError($"⚠ Teléfono debe tener 10 dígitos (actual: {cleaned.Length})");
            }
            else if (cleaned.Length == 10)
            {
                phoneNumberErrorMessage = "";
            }
        }
        else
        {
            // Para extranjeros: validación flexible
            phoneNumberErrorMessage = "";
        }

        _customer.PhoneNumber = cleaned;
        StateHasChanged();
    }


    /// Muestra mensaje de error temporal para teléfono
    private void ShowPhoneError(string message)
    {
        phoneNumberErrorMessage = message;

        // Cancelar timer anterior si existe
        phoneErrorTimer?.Dispose();

        // Crear nuevo timer para ocultar mensaje después de 3 segundos
        phoneErrorTimer = new System.Threading.Timer(_ =>
        {
            phoneNumberErrorMessage = "";
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    /// Obtiene el mensaje de validación para el teléfono
    private string GetPhoneMessage()
    {
        if (string.IsNullOrEmpty(_customer.PhoneNumber))
            return "";

        if (IsEcuadorian())
        {
            if (_customer.PhoneNumber.Length == 10)
                return "✓ 10 dígitos";
            else if (_customer.PhoneNumber.Length < 10)
                return $"⚠ {10 - _customer.PhoneNumber.Length} faltan";
            else
                return "⚠ Máximo 10";
        }
        else
        {
            if (_customer.PhoneNumber.StartsWith("+"))
                return "✓ Internacional";
            else
                return "✓ Nacional";
        }
    }

    private string GetPhonePlaceholder()
    {
        if (IsEcuadorian())
        {
            return "10 dígitos (Ej: 0991234567)";
        }
        else
        {
            return "+593 99 123 4567";
        }
    }

    private int GetPhoneNumberMaxLength()
    {
        if (IsEcuadorian())
        {
            return 10; // Máximo 10 dígitos para ecuatorianos
        }
        else
        {
            return 20; // Para extranjeros con código internacional
        }
    }

    /// Obtiene la clase CSS para el mensaje de teléfono
    private string GetPhoneMessageClass()
    {
        if (string.IsNullOrEmpty(_customer.PhoneNumber))
            return "text-gray-400";

        if (!string.IsNullOrEmpty(phoneNumberErrorMessage))
            return "text-gray-400";

        return "text-green-600 font-semibold";
    }

    /// Obtiene la clase CSS para el borde del input de teléfono
    private string GetPhoneBorderClass()
    {
        if (!string.IsNullOrEmpty(phoneNumberErrorMessage))
            return "border-red-500 focus:border-red-600";

        if (string.IsNullOrEmpty(_customer.PhoneNumber))
            return "border-gray-300 focus:border-blue-500";

        // Para ecuatorianos: verde solo si tiene 10 dígitos
        if (IsEcuadorian())
        {
            if (_customer.PhoneNumber.Length == 10)
                return "border-green-500 focus:border-green-600";
            else
                return "border-yellow-500 focus:border-yellow-600";
        }

        return "border-green-500 focus:border-green-600";
    }

    // ============================================================================
    // DISPOSE (Agregar o modificar el método Dispose existente)
    // ============================================================================

    public void Dispose()
    {
        documentErrorTimer?.Dispose();
        phoneErrorTimer?.Dispose();
    }

