@page "/settings/company"
@inject CarRental.Web.Services.CompanySettingsApiClient CompanySettingsApiClient
@inject IToastService ToastService
@using CarRental.Core.Models
@using Blazored.Toast.Services
@using Microsoft.AspNetCore.Components.Forms

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-4">
    <div class="max-w-4xl mx-auto">

        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Configuración de la Empresa</h1>
            <p class="text-gray-600 mt-2">Administra la información que aparecerá en los contratos PDF</p>
        </div>

        @if (isLoading)
        {
            <div class="bg-white rounded-2xl shadow-lg p-8">
                <div class="flex flex-col items-center justify-center space-y-4">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                    <p class="text-gray-600">Cargando configuración...</p>
                </div>
            </div>
        }
        else if (companySettings != null)
        {
            <div class="bg-white rounded-2xl shadow-lg p-6 space-y-6">

                <!-- Logo -->
                <div class="border-b pb-6">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Logo de la Empresa</h2>
                    <div class="flex items-center space-x-4">
                        @if (companySettings.Logo != null && companySettings.Logo.Length > 0)
                        {
                            <img src="@GetImageSrc()" alt="Logo" class="w-32 h-32 object-contain border rounded" />
                        }
                        else
                        {
                            <div class="w-32 h-32 bg-gray-200 rounded flex items-center justify-center">
                                <span class="text-gray-400">Sin logo</span>
                            </div>
                        }
                        <InputFile OnChange="HandleLogoUpload" class="text-sm" accept="image/*" />
                    </div>
                </div>

                <!-- Información de la Empresa -->
                <div>
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Información General</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Nombre de la Empresa *</label>
                            <input @bind="companySettings.CompanyName" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Descripción de Actividades</label>
                            <textarea @bind="companySettings.ActivityDescription" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Dirección *</label>
                            <input @bind="companySettings.Address" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Ciudad *</label>
                            <input @bind="companySettings.City" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                            <input @bind="companySettings.Email" type="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Teléfono 1 *</label>
                            <input @bind="companySettings.Phone1" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Teléfono 2</label>
                            <input @bind="companySettings.Phone2" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-2">Sitio Web / Redes Sociales</label>
                            <input @bind="companySettings.Website" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                        </div>
                    </div>
                </div>

                <!-- Botones -->
                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <button @onclick="SaveSettings" disabled="@isSaving" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50">
                        @if (isSaving)
                        {
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar Cambios</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private Core.Models.CompanySettings? companySettings;
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            isLoading = true;
            var result = await CompanySettingsApiClient.GetCompanySettingsAsync();

            if (result.IsSuccess && result.Data != null)
            {
                companySettings = result.Data;
            }
            else
            {
                ToastService.ShowError("Error al cargar configuración");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        if (companySettings == null) return;

        try
        {
            isSaving = true;
            var result = await CompanySettingsApiClient.UpdateCompanySettingsAsync(companySettings);

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Configuración guardada exitosamente");
            }
            else
            {
                ToastService.ShowError($"Error: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al guardar: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file.Size > 2 * 1024 * 1024)
            {
                ToastService.ShowError("El archivo no debe exceder 2MB");
                return;
            }

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024).CopyToAsync(memoryStream);

            var result = await CompanySettingsApiClient.UploadLogoAsync(memoryStream.ToArray());

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Logo actualizado exitosamente");
                await LoadSettings(); // Recargar para mostrar el nuevo logo
            }
            else
            {
                ToastService.ShowError($"Error al subir logo: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private string GetImageSrc()
    {
        if (companySettings?.Logo != null && companySettings.Logo.Length > 0)
        {
            var base64 = Convert.ToBase64String(companySettings.Logo);
            return $"data:image/png;base64,{base64}";
        }
        return string.Empty;
    }
}