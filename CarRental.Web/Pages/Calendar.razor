@page "/calendar"
@inject CarRental.Web.Services.RentalApiClient RentalApiClient
@inject CarRental.Web.Services.VehicleApiClient VehicleApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@using CarRental.Core.Models
@using Blazored.Toast.Services
@using System.Text.Json

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-4 md:p-6">
    <div class="max-w-7xl mx-auto">

        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-800">Calendario de Reservas</h1>
                <p class="text-gray-600 mt-1">Vista general de disponibilidad de vehículos</p>
            </div>
            @if (canCreate)
            {
                <a href="/rentals/add" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Nueva Reserva
                </a>
            }
        </div>

        @if (isLoadingPermissions)
        {
            <div class="bg-white p-12 rounded-xl shadow text-center">
                <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-blue-600 mx-auto mb-4"></div>
                <p class="text-gray-600 text-lg">Cargando permisos...</p>
            </div>
        }
        else if (!hasModuleAccess)
        {
            <div class="bg-white p-12 rounded-xl shadow text-center">
                <svg class="w-20 h-20 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <p class="text-gray-800 text-xl font-semibold mb-2">Acceso no autorizado</p>
                <p class="text-gray-600">No tienes permisos para acceder al calendario</p>
            </div>
        }
        else
        {
            <!-- Filtros -->
            <div class="bg-white p-4 rounded-xl shadow-md mb-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Filtro por Vehículo -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Vehículo</label>
                        <select @bind="selectedVehicleId" @bind:after="FilterEvents" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="0">Todos los vehículos</option>
                            @foreach (var vehicle in vehicles)
                            {
                                <option value="@vehicle.Id">@vehicle.Make @vehicle.Model (@vehicle.LicensePlate)</option>
                            }
                        </select>
                    </div>

                    <!-- Filtro por Estado -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Estado</label>
                        <select @bind="selectedStatus" @bind:after="FilterEvents" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="">Todos los estados</option>
                            <option value="Reservado">Reservado</option>
                            <option value="Activo">Activo</option>
                            <option value="Completado">Completado</option>
                            <option value="Vencido">Vencido</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>

                    <!-- Vista del Calendario -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Vista</label>
                        <select @bind="calendarView" @bind:after="ChangeView" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="dayGridMonth">Mensual</option>
                            <option value="timeGridWeek">Semanal</option>
                            <option value="timeGridDay">Diaria</option>
                            <option value="listWeek">Lista Semanal</option>
                        </select>
                    </div>
                </div>

                <!-- Leyenda de colores -->
                <div class="mt-4 pt-4 border-t border-gray-200">
                    <p class="text-sm font-medium text-gray-700 mb-2">Leyenda:</p>
                    <div class="flex flex-wrap gap-4">
                        <div class="flex items-center">
                            <div class="w-4 h-4 bg-blue-500 rounded mr-2"></div>
                            <span class="text-sm text-gray-600">Reservado</span>
                        </div>
                        <div class="flex items-center">
                            <div class="w-4 h-4 bg-green-500 rounded mr-2"></div>
                            <span class="text-sm text-gray-600">Activo</span>
                        </div>
                        <div class="flex items-center">
                            <div class="w-4 h-4 bg-gray-500 rounded mr-2"></div>
                            <span class="text-sm text-gray-600">Completado</span>
                        </div>
                        <div class="flex items-center">
                            <div class="w-4 h-4 bg-red-500 rounded mr-2"></div>
                            <span class="text-sm text-gray-600">Vencido</span>
                        </div>
                        <div class="flex items-center">
                            <div class="w-4 h-4 bg-yellow-500 rounded mr-2"></div>
                            <span class="text-sm text-gray-600">Cancelado</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Calendario -->
            <div class="bg-white p-4 rounded-xl shadow-md">
                <div id="calendar"></div>
            </div>

            @if (isLoadingData)
            {
                <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                    <div class="bg-white p-8 rounded-xl shadow-2xl">
                        <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-blue-600 mx-auto mb-4"></div>
                        <p class="text-gray-800 text-lg font-semibold">Cargando calendario...</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    // Permisos
    private bool isLoadingPermissions = true;
    private bool hasModuleAccess = false;
    private bool canView = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;

    // Datos
    private bool isLoadingData = false;
    private List<Rental> rentals = new();
    private List<Vehicle> vehicles = new();

    // Filtros
    private int selectedVehicleId = 0;
    private string selectedStatus = "";
    private string calendarView = "dayGridMonth";

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();

        if (hasModuleAccess && canView)
        {
            await LoadData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && hasModuleAccess && canView)
        {
            await InitializeCalendar();
        }
    }

    private async Task LoadPermissions()
    {
        try
        {
            isLoadingPermissions = true;
            var modulePermissions = await PermissionApiClient.GetModulePermissionsAsync("Rental");

            if (modulePermissions != null)
            {
                hasModuleAccess = modulePermissions.HasAccess;
                canView = modulePermissions.CanView;
                canCreate = modulePermissions.CanCreate;
                canEdit = modulePermissions.CanEdit;
                canDelete = modulePermissions.CanDelete;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar permisos: {ex.Message}");
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            StateHasChanged();

            var rentalsTask = RentalApiClient.GetRentalsAsync();
            var vehiclesTask = VehicleApiClient.GetVehiclesAsync();

            await Task.WhenAll(rentalsTask, vehiclesTask);

            rentals = rentalsTask.Result?.Data?.ToList() ?? new List<Rental>();
            vehicles = vehiclesTask.Result?.Data?.ToList() ?? new List<Vehicle>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

    private async Task InitializeCalendar()
    {
        try
        {
            var events = GetFilteredEvents();
            var eventsJson = JsonSerializer.Serialize(events);

            await JSRuntime.InvokeVoidAsync("initializeCalendar", eventsJson, DotNetObjectReference.Create(this));
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al inicializar calendario: {ex.Message}");
        }
    }

    private List<CalendarEvent> GetFilteredEvents()
    {
        var filtered = rentals.AsEnumerable();

        // Filtrar por vehículo
        if (selectedVehicleId > 0)
        {
            filtered = filtered.Where(r => r.VehicleId == selectedVehicleId);
        }

        // Filtrar por estado
        if (!string.IsNullOrEmpty(selectedStatus))
        {
            filtered = filtered.Where(r => r.Status.ToString() == selectedStatus);
        }

        return filtered.Select(r => new CalendarEvent
        {
            id = r.Id.ToString(),
            title = $"{r.Vehicle?.Make} {r.Vehicle?.Model} - {r.Customer?.FirstName} {r.Customer?.LastName}",
            start = r.StartDate.ToString("yyyy-MM-ddTHH:mm:ss"),
            end = r.EndDate.ToString("yyyy-MM-ddTHH:mm:ss"),
            backgroundColor = GetStatusColor(r.Status),
            borderColor = GetStatusColor(r.Status),
            extendedProps = new
            {
                rentalId = r.Id,
                vehicleId = r.VehicleId,
                customerId = r.CustomerId,
                status = r.Status.ToString(),
                dailyRate = r.DailyRate,
                totalCost = r.TotalCost,
                licensePlate = r.Vehicle?.LicensePlate,
                customerName = $"{r.Customer?.FirstName} {r.Customer?.LastName}"
            }
        }).ToList();
    }

    private string GetStatusColor(Rental.RentalStatus status)
    {
        return status switch
        {
            Rental.RentalStatus.Reservado => "#3b82f6",    // Azul
            Rental.RentalStatus.Activo => "#10b981",       // Verde
            Rental.RentalStatus.Completado => "#6b7280",   // Gris
            Rental.RentalStatus.Vencido => "#ef4444",      // Rojo
            Rental.RentalStatus.Cancelado => "#eab308",    // Amarillo
            Rental.RentalStatus.Dañado => "#f97316",       // Naranja
            _ => "#6b7280"
        };
    }

    private async Task FilterEvents()
    {
        await UpdateCalendarEvents();
    }

    private async Task ChangeView()
    {
        await JSRuntime.InvokeVoidAsync("changeCalendarView", calendarView);
    }

    private async Task UpdateCalendarEvents()
    {
        var events = GetFilteredEvents();
        var eventsJson = JsonSerializer.Serialize(events);
        await JSRuntime.InvokeVoidAsync("updateCalendarEvents", eventsJson);
    }

    [JSInvokable]
    public void OnEventClick(string eventId)
    {
        if (int.TryParse(eventId, out int rentalId) && canView)
        {
            NavigationManager.NavigateTo($"/rentals/details/{rentalId}");
        }
    }

    [JSInvokable]
    public void OnDateClick(string dateStr)
    {
        if (canCreate)
        {
            NavigationManager.NavigateTo($"/rentals/add?date={dateStr}");
        }
    }

    [JSInvokable]
    public async Task<bool> OnEventDrop(string eventId, string newStartStr, string newEndStr)
    {
        if (!canEdit)
        {
            ToastService.ShowWarning("No tienes permisos para modificar reservas");
            return false;
        }

        try
        {
            if (!int.TryParse(eventId, out int rentalId))
                return false;

            var rental = rentals.FirstOrDefault(r => r.Id == rentalId);
            if (rental == null)
                return false;

            // Actualizar fechas
            rental.StartDate = DateTime.Parse(newStartStr);
            rental.EndDate = DateTime.Parse(newEndStr);

            // Guardar en la API - El método UpdateRentalAsync acepta Rental completo
            var result = await RentalApiClient.UpdateRentalAsync(rental);

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Reserva actualizada exitosamente");
                return true;
            }
            else
            {
                ToastService.ShowError($"Error: {result.ErrorMessage}");
                return false;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al actualizar reserva: {ex.Message}");
            return false;
        }
    }

    // Clase para serializar eventos del calendario
    public class CalendarEvent
    {
        public string id { get; set; }
        public string title { get; set; }
        public string start { get; set; }
        public string end { get; set; }
        public string backgroundColor { get; set; }
        public string borderColor { get; set; }
        public object extendedProps { get; set; }
    }
}
