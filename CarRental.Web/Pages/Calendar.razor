@page "/calendar"
@inject CarRental.Web.Services.RentalApiClient RentalApiClient
@inject CarRental.Web.Services.VehicleApiClient VehicleApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@using CarRental.Core.Models
@using Blazored.Toast.Services
@using System.Text.Json

<PageTitle>Calendario - CarRental</PageTitle>

<div class="min-h-screen bg-gray-50 p-0 m-0">
    <div class="w-full h-full">

        @if (isLoadingPermissions)
        {
            <div class="flex items-center justify-center h-screen">
                <div class="text-center">
                    <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-blue-600 mx-auto mb-4"></div>
                    <p class="text-gray-600 text-lg">Cargando calendario...</p>
                </div>
            </div>
        }
        else if (!hasModuleAccess)
        {
            <div class="flex items-center justify-center h-screen">
                <div class="text-center">
                    <svg class="w-20 h-20 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <p class="text-gray-800 text-xl font-semibold mb-2">Acceso no autorizado</p>
                    <p class="text-gray-600">No tienes permisos para acceder al calendario</p>
                </div>
            </div>
        }
        else
        {
            <!-- Encabezado -->
            <div class="px-6 py-4">
                <h1 class="text-3xl font-bold text-gray-800">Calendario de Reservas</h1>
            </div>
            <!-- Sección de filtros -->
            <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Vehículo</label>
                        <select @bind="selectedVehicleId" @bind:after="FilterEvents"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="0">Todos los vehículos</option>
                            @foreach (var vehicle in vehicles)
                            {
                                <option value="@vehicle.Id">@vehicle.Make @vehicle.Model (@vehicle.LicensePlate)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Estado</label>
                        <select @bind="selectedStatus" @bind:after="FilterEvents"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="">Todos los estados</option>
                            @foreach (var status in Enum.GetValues<Rental.RentalStatus>())
                            {
                                <option value="@status">@status.ToString()</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="flex justify-between items-center mt-4">
@*                     <span class="font-medium">Leyenda:</span> *@
                    <div class="flex items-center gap-1.5 text-sm">
                        <div class="w-3 h-3 rounded-full bg-blue-500"></div>
                        <span>Reservado</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-sm">
                        <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        <span>Activo</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-sm">
                        <div class="w-3 h-3 rounded-full bg-gray-500"></div>
                        <span>Completado</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-sm">
                        <div class="w-3 h-3 rounded-full bg-red-500"></div>
                        <span>Vencido</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-sm">
                        <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                        <span>Cancelado</span>
                    </div>
                    <button @onclick="ClearFilters" class="px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors">
                        Limpiar filtros
                    </button>
                </div>
            </div>

            <!-- Layout: Calendario + Sidebar (FLEXBOX SIMPLE) -->
            <div class="flex" style="height: calc(100vh - 200px);">

                <!-- CALENDARIO -->
                <div id="calendar-container" class="bg-white" style="flex: 1; min-width: 0;">
                    <div id="calendar" style="width: 100%; height: 100%; padding: 16px;"></div>
                </div>

                <!-- SIDEBAR (solo visible en Mes) -->
                <div id="events-sidebar" class="bg-white border-l border-gray-200 flex-col" style="display: none; width: 320px; min-width: 320px; max-width: 320px;">

                    <!-- Botones de vista en la parte superior -->
                    <div class="p-4 border-b border-gray-200 flex-shrink-0">
                        <!-- Espacio para alineación con los botones del calendario -->
                        <div style="height: 40px;"></div>
                    </div>

                    <!-- Fecha y botón + -->
                    <div class="p-4 border-b border-gray-200 flex-shrink-0">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-lg font-bold text-gray-800">@selectedDate.ToString("dddd, d")</h2>
                            @if (canCreate)
                            {
                                <button @onclick="AddRentalOnSelectedDate"
                                        class="w-10 h-10 flex items-center justify-center bg-blue-600 text-white rounded-full hover:bg-blue-700 transition-all shadow-md hover:shadow-lg flex-shrink-0"
                                        title="Agregar reserva">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                                    </svg>
                                </button>
                            }
                        </div>
                        <p class="text-sm text-gray-500">@selectedDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-EC"))</p>
                    </div>

                    <!-- Lista de eventos con scroll -->
                    <div class="flex-1 overflow-y-auto p-4">
                        @if (eventsOnSelectedDate.Any())
                        {
                            <div class="space-y-2">
                                @foreach (var rental in eventsOnSelectedDate)
                                {
                                    <div @onclick="() => ViewRentalDetails(rental.Id)"
                                         class="group p-3 rounded-lg border-l-4 bg-gray-50 hover:bg-gray-100 cursor-pointer transition-all"
                                         style="border-color: @GetStatusColor(rental.Status)">

                                        <div class="flex items-center justify-between gap-2">
                                            <p class="font-semibold text-sm text-gray-900 flex-1" style="word-wrap: break-word; overflow-wrap: break-word;">
                                                @rental.Vehicle?.Make @rental.Vehicle?.Model
                                            </p>
                                            <span class="text-xs px-2 py-0.5 rounded-full text-white font-medium whitespace-nowrap flex-shrink-0"
                                                  style="background-color: @GetStatusColor(rental.Status)">
                                                @rental.Status.ToString()
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center py-12 text-center">
                                <svg class="w-16 h-16 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <p class="text-sm font-medium text-gray-500">No hay eventos</p>
                                <p class="text-xs text-gray-400 mt-1">en este día</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (isLoadingData)
            {
                <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                    <div class="bg-white p-8 rounded-xl shadow-2xl">
                        <div class="animate-spin rounded-full h-16 w-16 border-b-4 border-blue-600 mx-auto mb-4"></div>
                        <p class="text-gray-800 text-lg font-semibold">Cargando datos...</p>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool isLoadingPermissions = true;
    private bool hasModuleAccess = false;
    private bool canView = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;

    private bool isLoadingData = false;
    private List<Rental> rentals = new();
    private List<Vehicle> vehicles = new();

    private int selectedVehicleId = 0;
    private string selectedStatus = "";

    private DateTime selectedDate = DateTime.Today;
    private List<Rental> eventsOnSelectedDate = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();
        if (hasModuleAccess && canView)
        {
            await LoadData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && hasModuleAccess && canView)
        {
            await InitializeCalendar();
        }
    }

    private async Task LoadPermissions()
    {
        try
        {
            isLoadingPermissions = true;
            var modulePermissions = await PermissionApiClient.GetModulePermissionsAsync("Rental");

            if (modulePermissions != null)
            {
                hasModuleAccess = modulePermissions.HasAccess;
                canView = modulePermissions.CanView;
                canCreate = modulePermissions.CanCreate;
                canEdit = modulePermissions.CanEdit;
                canDelete = modulePermissions.CanDelete;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar permisos: {ex.Message}");
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

    private async Task LoadData()
    {
        try
        {
            isLoadingData = true;
            StateHasChanged();

            var rentalsTask = RentalApiClient.GetRentalsAsync();
            var vehiclesTask = VehicleApiClient.GetVehiclesAsync();

            await Task.WhenAll(rentalsTask, vehiclesTask);

            rentals = rentalsTask.Result?.Data?.ToList() ?? new List<Rental>();
            vehicles = vehiclesTask.Result?.Data?.ToList() ?? new List<Vehicle>();

            UpdateEventsForSelectedDate();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

    private async Task InitializeCalendar()
    {
        try
        {
            var events = GetFilteredEvents();
            var eventsJson = JsonSerializer.Serialize(events);
            await JSRuntime.InvokeVoidAsync("initializeCalendar", eventsJson, DotNetObjectReference.Create(this));
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al inicializar calendario: {ex.Message}");
        }
    }

    private List<CalendarEvent> GetFilteredEvents()
    {
        try
        {
            var filtered = rentals.AsEnumerable();

            if (selectedVehicleId > 0)
                filtered = filtered.Where(r => r.VehicleId == selectedVehicleId);

            if (!string.IsNullOrEmpty(selectedStatus))
                filtered = filtered.Where(r => r.Status.ToString() == selectedStatus);

            return filtered.Select(r => new CalendarEvent
            {
                id = r.Id.ToString(),
                title = $"{r.Vehicle?.Make ?? "N/A"} {r.Vehicle?.Model ?? ""}".Trim(),
                start = r.StartDate.ToString("yyyy-MM-dd'T'HH:mm:ss"),
                end = r.EndDate.ToString("yyyy-MM-dd'T'HH:mm:ss"),
                backgroundColor = GetStatusColor(r.Status),
                borderColor = GetStatusColor(r.Status),
                extendedProps = new
                {
                    rentalId = r.Id,
                    status = r.Status.ToString(),
                    make = r.Vehicle?.Make ?? "",
                    model = r.Vehicle?.Model ?? "",
                    licensePlate = r.Vehicle?.LicensePlate ?? "",
                    customerName = $"{r.Customer?.FirstName ?? ""} {r.Customer?.LastName ?? ""}".Trim()
                }
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en GetFilteredEvents: {ex.Message}");
            return new List<CalendarEvent>();
        }
    }

    private string GetStatusColor(Rental.RentalStatus status) => status switch
    {
        Rental.RentalStatus.Reservado => "#3b82f6",
        Rental.RentalStatus.Activo => "#10b981",
        Rental.RentalStatus.Completado => "#6b7280",
        Rental.RentalStatus.Vencido => "#ef4444",
        Rental.RentalStatus.Cancelado => "#eab308",
        Rental.RentalStatus.Dañado => "#f97316",
        _ => "#6b7280"
    };

    private async Task FilterEvents()
    {
        await UpdateCalendarEvents();
        UpdateEventsForSelectedDate();
        StateHasChanged();
    }

    private async Task ClearFilters()
    {
        selectedVehicleId = 0;
        selectedStatus = "";
        await FilterEvents();
    }

    private async Task UpdateCalendarEvents()
    {
        var events = GetFilteredEvents();
        var eventsJson = JsonSerializer.Serialize(events);
        await JSRuntime.InvokeVoidAsync("updateCalendarEvents", eventsJson);
    }

    private void UpdateEventsForSelectedDate()
    {
        var filtered = rentals.AsEnumerable();

        if (selectedVehicleId > 0)
            filtered = filtered.Where(r => r.VehicleId == selectedVehicleId);

        if (!string.IsNullOrEmpty(selectedStatus))
            filtered = filtered.Where(r => r.Status.ToString() == selectedStatus);

        eventsOnSelectedDate = filtered
            .Where(r => r.StartDate.Date <= selectedDate.Date && r.EndDate.Date >= selectedDate.Date)
            .OrderBy(r => r.StartDate)
            .ToList();
    }

    [JSInvokable("OnDateClick")]
    public void OnDateClick(string dateStr)
    {
        try
        {
            if (DateTime.TryParse(dateStr, out DateTime date))
            {
                selectedDate = date;
                UpdateEventsForSelectedDate();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en OnDateClick: {ex.Message}");
        }
    }

    [JSInvokable("OnEventClick")]
    public void OnEventClick(string eventId)
    {
        // No hacer nada
    }

    private void ViewRentalDetails(int rentalId)
    {
        if (canView)
            NavigationManager.NavigateTo($"/rentals/details/{rentalId}");
    }

    private void AddRentalOnSelectedDate()
    {
        if (canCreate)
            NavigationManager.NavigateTo($"/rentals/add?date={selectedDate:yyyy-MM-dd}");
    }

    [JSInvokable("OnEventDrop")]
    public async Task<bool> OnEventDrop(string eventId, string newStartStr, string newEndStr)
    {
        if (!canEdit)
        {
            ToastService.ShowWarning("No tienes permisos para modificar reservas");
            return false;
        }

        try
        {
            if (!int.TryParse(eventId, out int rentalId))
                return false;

            var rental = rentals.FirstOrDefault(r => r.Id == rentalId);
            if (rental == null)
                return false;

            rental.StartDate = DateTime.Parse(newStartStr);
            rental.EndDate = DateTime.Parse(newEndStr);

            var result = await RentalApiClient.UpdateRentalAsync(rental);

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Reserva actualizada");
                await LoadData();
                await UpdateCalendarEvents();
                return true;
            }
            else
            {
                ToastService.ShowError($"Error: {result.ErrorMessage}");
                return false;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
            return false;
        }
    }

    public class CalendarEvent
    {
        public string id { get; set; }
        public string title { get; set; }
        public string start { get; set; }
        public string end { get; set; }
        public string backgroundColor { get; set; }
        public string borderColor { get; set; }
        public object extendedProps { get; set; }
    }
}
