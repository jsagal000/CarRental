@page "/profile"
@inject CarRental.Web.Services.UserApiClient UserApiClient
@inject CarRental.Web.Services.AuthStateService AuthState
@inject IToastService ToastService
@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using Blazored.Toast.Services

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-6">
    <div class="max-w-2xl mx-auto">

        <!-- Encabezado -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800">Mi Perfil</h1>
            <p class="text-gray-600 mt-2">Administra tu información personal y configuración</p>
        </div>

        <!-- Información del Usuario -->
        <div class="bg-white rounded-xl shadow p-6 mb-6">
            <div class="flex items-center mb-6">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mr-4">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">@AuthState.CurrentUser?.FullName</h2>
                    <p class="text-gray-600">@AuthState.CurrentUser?.Email</p>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetRoleBadgeClass(AuthState.CurrentUser?.Role ?? UserRole.ReadOnly)">
                        @GetRoleDisplayName(AuthState.CurrentUser?.Role ?? UserRole.ReadOnly)
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-600">
                <div>
                    <span class="font-medium">Usuario:</span> @AuthState.CurrentUser?.Username
                </div>
                <div>
                    <span class="font-medium">Estado:</span>
                    <span class="text-green-600">Activo</span>
                </div>
                <div>
                    <span class="font-medium">Fecha de Registro:</span>
                    @AuthState.CurrentUser?.CreatedAt.ToString("dd/MM/yyyy")
                </div>
                @if (AuthState.CurrentUser?.LastLoginAt.HasValue == true)
                {
                    <div>
                        <span class="font-medium">Último Acceso:</span>
                        @AuthState.CurrentUser.LastLoginAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                    </div>
                }
            </div>
        </div>

        <!-- Cambiar Contraseña -->
        <div class="bg-white rounded-xl shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Cambiar Contraseña</h3>

            <EditForm Model="changePasswordModel" OnValidSubmit="HandleChangePassword">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña Actual</label>
                        <InputText @bind-Value="changePasswordModel.CurrentPassword"
                                   type="password"
                                   class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Ingresa tu contraseña actual" />
                        <ValidationMessage For="@(() => changePasswordModel.CurrentPassword)" class="text-red-500 text-sm mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nueva Contraseña</label>
                        <InputText @bind-Value="changePasswordModel.NewPassword"
                                   type="password"
                                   class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Ingresa tu nueva contraseña" />
                        <ValidationMessage For="@(() => changePasswordModel.NewPassword)" class="text-red-500 text-sm mt-1" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Confirmar Nueva Contraseña</label>
                        <InputText @bind-Value="changePasswordModel.ConfirmPassword"
                                   type="password"
                                   class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Confirma tu nueva contraseña" />
                        <ValidationMessage For="@(() => changePasswordModel.ConfirmPassword)" class="text-red-500 text-sm mt-1" />
                    </div>

                    <!-- Mensaje de Error -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="p-3 bg-red-100 border border-red-400 text-red-700 rounded-lg">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                @errorMessage
                            </div>
                        </div>
                    }

                    <div class="pt-4">
                        <button type="submit"
                                disabled="@isChangingPassword"
                                class="w-full inline-flex items-center justify-center px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:bg-gray-400 transition-colors font-medium">
                            @if (isChangingPassword)
                            {
                                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Cambiando contraseña...</span>
                            }
                            else
                            {
                                <span>Cambiar Contraseña</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>

        <!-- Información de Seguridad -->
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mt-6">
            <div class="flex items-start">
                <svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                    <h4 class="text-sm font-medium text-blue-800">Consejos de Seguridad</h4>
                    <div class="text-sm text-blue-700 mt-1">
                        <ul class="list-disc list-inside space-y-1">
                            <li>Usa una contraseña de al menos 8 caracteres</li>
                            <li>Incluye mayúsculas, minúsculas, números y símbolos</li>
                            <li>No compartas tu contraseña con nadie</li>
                            <li>Cambia tu contraseña regularmente</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ChangePasswordDto changePasswordModel = new();
    private bool isChangingPassword = false;
    private string errorMessage = string.Empty;

    private async Task HandleChangePassword()
    {
        if (isChangingPassword) return;

        errorMessage = string.Empty;
        isChangingPassword = true;

        try
        {
            var result = await UserApiClient.ChangePasswordAsync(changePasswordModel);

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Contraseña cambiada exitosamente");
                changePasswordModel = new ChangePasswordDto(); // Limpiar formulario
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Error al cambiar la contraseña";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private string GetRoleBadgeClass(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => "bg-purple-100 text-purple-800",
            UserRole.Manager => "bg-blue-100 text-blue-800",
            UserRole.Employee => "bg-green-100 text-green-800",
            UserRole.ReadOnly => "bg-gray-100 text-gray-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetRoleDisplayName(UserRole role)
    {
        return role switch
        {
            UserRole.Admin => "Administrador",
            UserRole.Manager => "Manager",
            UserRole.Employee => "Empleado",
            UserRole.ReadOnly => "Solo Lectura",
            _ => "Desconocido"
        };
    }
}