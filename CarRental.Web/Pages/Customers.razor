@page "/customers"
@inject CarRental.Web.Services.CustomerApiClient CustomerApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject CarRental.Web.Services.ModalService ModalService
@inject IToastService ToastService
@using CarRental.Core.Models
@using Blazored.Toast.Services

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-6">
    <div class="max-w-7xl mx-auto">

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Gestión de Clientes</h1>
            @if (canCreate)
            {
                <a href="/customers/add" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Nuevo Cliente
                </a>
            }
        </div>

        @if (isLoadingPermissions)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <div class="flex flex-col items-center justify-center space-y-4">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                    <p class="text-gray-600 text-lg">Cargando información...</p>
                </div>
            </div>
        }
        else if (!hasModuleAccess)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <p class="text-gray-800 text-lg">Acceso no autorizado</p>
                <p class="text-gray-600 text-sm mt-2">No tienes permisos para acceder a este módulo</p>
            </div>
        }
        else if (!canView)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <p class="text-gray-800 text-lg">Acceso no autorizado</p>
                <p class="text-gray-600 text-sm mt-2">No tienes permisos para ver la lista de clientes</p>
            </div>
        }
        else
        {
            @if (canView)
            {
                <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                    <div class="grid grid-cols-1 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Buscar</label>
                            <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged"
                                   placeholder="Nombre, apellido o documento..."
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>
                    </div>

                    <div class="flex justify-between items-center mt-4">
                        <div class="text-sm text-gray-600">
                            Mostrando @GetPagedCustomers().Count() de @filteredCustomers.Count() clientes (Total: @(allCustomers?.Count() ?? 0))
                        </div>
                        <button @onclick="ClearFilters" class="px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors">
                            Limpiar filtros
                        </button>
                    </div>
                </div>
            }

            @if (isLoadingPermissions || allCustomers == null && string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                    Cargando...
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-red-600 text-lg">
                    @errorMessage
                </div>
            }
            else if (allCustomers != null && !allCustomers.Any())
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                    No hay clientes registrados.
                    @if (canCreate)
                    {
                        <div class="mt-4">
                            <a href="/customers/add" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                Crear el primer cliente
                            </a>
                        </div>
                    }
                </div>
            }
            else if (!filteredCustomers.Any())
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                    No se encontraron clientes que coincidan con los filtros aplicados.
                    <div class="mt-4">
                        <button @onclick="ClearFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            Limpiar filtros
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full bg-white rounded-xl shadow overflow-hidden">
                        <thead class="bg-gray-100 text-gray-600 text-sm uppercase">
                            <tr>
                                <th class="px-3 py-2 text-left">Nombres</th>
                                <th class="px-3 py-2 text-left">Apellidos</th>
                                <th class="px-3 py-2 text-left">Teléfono</th>
                                <th class="px-3 py-2 text-left">Tipo Documento</th>
                                <th class="px-3 py-2 text-left">Número Documento</th>
                                @if (canView || canEdit || canDelete)
                                {
                                    <th class="px-3 py-2 text-center">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in GetPagedCustomers())
                            {
                                <tr class="border-t border-gray-100 hover:bg-gray-50">
                                    <td class="px-3 py-2 text-gray-800">@customer.FirstName</td>
                                    <td class="px-3 py-2 text-gray-800">@customer.LastName</td>
                                    <td class="px-3 py-2 text-gray-800">@customer.PhoneNumber</td>
                                    <td class="px-3 py-2 text-gray-800">@customer.TypeOfDocument.ToString()</td>
                                    <td class="px-3 py-2 text-gray-800">@customer.DocumentNumber</td>
                                    @if (canView || canEdit || canDelete)
                                    {
                                        <td class="px-3 py-2 text-center">
                                            <div class="flex justify-center space-x-2">
                                                @if (canView)
                                                {
                                                    <a href="/customers/details/@customer.Id" class="p-2 bg-blue-100 text-blue-600 hover:bg-blue-200 rounded-full" title="Ver detalles">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                        </svg>
                                                    </a>
                                                }
                                                @if (canEdit)
                                                {
                                                    <a href="/customers/edit/@customer.Id" class="p-2 bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded-full" title="Editar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z" />
                                                        </svg>
                                                    </a>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button @onclick="() => ConfirmDelete(customer.Id)" class="p-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-full" title="Eliminar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (filteredCustomers.Count() > pageSize)
                {
                    <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 mt-2 rounded-b-xl">
                        <div class="flex items-center justify-between">
                            <div class="text-sm text-gray-700">
                                Mostrando @((currentPage - 1) * pageSize + 1) a @(Math.Min(currentPage * pageSize, filteredCustomers.Count())) de @filteredCustomers.Count() resultados
                            </div>
                            <div class="flex space-x-2">
                                <button @onclick="PreviousPage" disabled="@(currentPage == 1)"
                                        class="px-3 py-1 text-sm bg-white border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
                                    Anterior
                                </button>
                                <span class="px-3 py-1 text-sm bg-blue-600 text-white rounded">
                                    @currentPage
                                </span>
                                <button @onclick="NextPage" disabled="@(currentPage* pageSize >= filteredCustomers.Count())"
                                        class="px-3 py-1 text-sm bg-white border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
                                    Siguiente
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private IEnumerable<Customer> allCustomers;
    private IEnumerable<Customer> filteredCustomers = new List<Customer>();
    private string errorMessage = string.Empty;
    private bool isLoadingPermissions = true;

    private int currentPage = 1;
    private int pageSize = 10;
    private System.Threading.Timer searchTimer;

    // Permisos jerárquicos
    private bool hasModuleAccess = false;
    private bool canView = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;

    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();

        if (hasModuleAccess && canView)
        {
            await LoadCustomers();
        }

        isLoadingPermissions = false;
    }

    private async Task LoadPermissions()
    {
        try
        {
            var perms = await PermissionApiClient.GetModulePermissionsAsync("Customer");
            hasModuleAccess = perms.HasAccess;

            if (!hasModuleAccess)
            {
                return;
            }

            canView = perms.CanView;
            canCreate = perms.CanCreate;
            canEdit = perms.CanEdit;
            canDelete = perms.CanDelete;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar permisos: {ex.Message}");
            hasModuleAccess = false;
        }
    }

    private async Task LoadCustomers()
    {
        errorMessage = string.Empty;
        var result = await CustomerApiClient.GetAllCustomersAsync();

        if (result.IsSuccess)
        {
            allCustomers = result.Data;
            ApplyFilters();
        }
        else
        {
            allCustomers = new List<Customer>();
            filteredCustomers = new List<Customer>();
            errorMessage = $"Error al cargar clientes: {result.ErrorMessage}";
            ToastService.ShowError(errorMessage);
        }
    }

    private void ApplyFilters()
    {
        if (allCustomers == null) return;

        var filtered = allCustomers.AsQueryable();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            var search = searchTerm.ToLower().Trim();
            filtered = filtered.Where(c =>
                (c.FirstName != null && c.FirstName.ToLower().Contains(search)) ||
                (c.LastName != null && c.LastName.ToLower().Contains(search)) ||
                (c.DocumentNumber != null && c.DocumentNumber.ToLower().Contains(search))
            );
        }

        filteredCustomers = filtered.ToList();
        StateHasChanged();
    }

    private void OnSearchChanged()
    {
        searchTimer?.Dispose();
        searchTimer = new System.Threading.Timer((_) => InvokeAsync(() =>
        {
            currentPage = 1;
            ApplyFilters();
        }), null, 300, System.Threading.Timeout.Infinite);
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        currentPage = 1;
        ApplyFilters();
    }

    private IEnumerable<Customer> GetPagedCustomers()
    {
        return filteredCustomers.Skip((currentPage - 1) * pageSize).Take(pageSize);
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (currentPage * pageSize < filteredCustomers.Count())
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete(int customerId)
    {
        if (!canDelete)
        {
            ToastService.ShowError("No tienes permisos para eliminar clientes");
            return;
        }

        // Obtener información del cliente para mostrar en el modal
        var customer = allCustomers.FirstOrDefault(c => c.Id == customerId);
        var customerInfo = customer != null
            ? $"al cliente {customer.FirstName} {customer.LastName} ({customer.DocumentNumber})"
            : "este cliente";

        // Mostrar modal de confirmación
        var confirmed = await ModalService.ConfirmDeleteAsync(customerInfo);

        if (confirmed)
        {
            await HandleDelete(customerId);
        }
    }

    private async Task HandleDelete(int customerId)
    {
        // Mostrar loading
        await ModalService.ShowLoadingAsync("Eliminando cliente...");

        var result = await CustomerApiClient.DeleteCustomerAsync(customerId);

        // Cerrar loading
        await ModalService.CloseAsync();

        if (result.IsSuccess)
        {
            await ModalService.ShowSuccessAsync("¡Eliminado!", "El cliente ha sido eliminado exitosamente.");
            await LoadCustomers();
        }
        else
        {
            await ModalService.ShowErrorAsync("Error al Eliminar", result.ErrorMessage ?? "Ocurrió un error inesperado");
        }
    }
}