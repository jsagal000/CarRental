@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using CarRental.Web.Models
@using CarRental.Web.Services
@using Blazored.Toast.Services
@using System.Text.Json
@using System.Globalization
@inject IVehicleSubResourceApiClient<Maintenance, MaintenanceForCreationDto> ApiClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-4 font-sans flex flex-col items-center">
    <div class="w-full max-w-2xl bg-white p-6 rounded-lg shadow-md">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-bold text-gray-800">@(Maintenance.Id == 0 ? "Añadir Nuevo Mantenimiento" : "Editar Mantenimiento")</h3>
        @if (Maintenance.Id == 0)
        {
            <button type="button"
                    @onclick="ClearForm"
                    class="text-blue-600 hover:text-blue-800 underline text-sm font-medium transition-colors duration-200">
                Limpiar formulario
            </button>
        }
    </div>
    <EditForm Model="Maintenance" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        @if (_apiResponse != null && !_apiResponse.IsSuccess)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <strong class="font-bold">¡Error!</strong>
                <span class="block sm:inline">@_apiResponse.ErrorMessage</span>
                @if (_apiResponse.ValidationErrors != null)
                {
                    <ul class="list-disc ml-5 mt-2">
                        @foreach (var error in _apiResponse.ValidationErrors.SelectMany(err => err.Value))
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

            <!-- ============ CAMPOS ORIGINALES ============ -->

            <div>
                <label class="block text-sm font-medium text-gray-700">Fecha:</label>
                <InputDate @bind-Value="Maintenance.Date" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Maintenance.Date)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Costo:</label>
                <InputNumber @bind-Value="Maintenance.Cost" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Maintenance.Cost)" />
            </div>

            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700">Descripción:</label>
                <InputTextArea @bind-Value="FormattedDescription" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 h-20" />
                <ValidationMessage For="@(() => Maintenance.Description)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Taller:</label>
                <InputText @bind-Value="FormattedWorkshopName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Maintenance.WorkshopName)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Kilometraje:</label>
                <InputNumber @bind-Value="Maintenance.Mileage" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Maintenance.Mileage)" />
            </div>

            <!-- ============ CAMPOS NUEVOS ============ -->

            <div>
                <label class="block text-sm font-medium text-gray-700">Tipo de Mantenimiento:</label>
                <InputSelect @bind-Value="Maintenance.Type" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var type in Enum.GetValues<Maintenance.MaintenanceType>())
                    {
                        <option value="@type">@GetMaintenanceTypeText(type)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Maintenance.Type)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Categoría:</label>
                <InputSelect @bind-Value="Maintenance.Category" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var category in Enum.GetValues<Maintenance.MaintenanceCategory>())
                    {
                        <option value="@category">@GetMaintenanceCategoryText(category)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Maintenance.Category)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Próximo Mantenimiento (Fecha):</label>
                <InputDate @bind-Value="Maintenance.NextMaintenanceDate" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Maintenance.NextMaintenanceDate)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Próximo Mantenimiento (Km):</label>
                <InputNumber @bind-Value="Maintenance.NextMaintenanceMileage" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Maintenance.NextMaintenanceMileage)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Número de Factura:</label>
                <InputText @bind-Value="FormattedInvoiceNumber" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" placeholder="Ej: FAC-2024-001" />
                <ValidationMessage For="@(() => Maintenance.InvoiceNumber)" />
            </div>

            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700">Notas Adicionales:</label>
                <InputTextArea @bind-Value="FormattedNotes" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 h-20" placeholder="Observaciones del mecánico, recomendaciones, etc." />
                <ValidationMessage For="@(() => Maintenance.Notes)" />
            </div>
        </div>

        <div class="flex justify-end space-x-4 pt-6">
            <button type="button" @onclick="() => OnSaveOrCancel.InvokeAsync()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-400 transition duration-300 ease-in-out shadow-md font-semibold">Cancelar</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">Guardar</button>
        </div>
    </EditForm>
</div>
</div>


@code {
    [Parameter] public Maintenance Maintenance { get; set; }
    [Parameter] public EventCallback OnSaveOrCancel { get; set; }

    private ApiResponse _apiResponse;

    // Propiedades formateadas con capitalización automática
    private string FormattedDescription
    {
        get => Maintenance.Description;
        set => Maintenance.Description = CapitalizeEachWord(value);
    }

    private string FormattedWorkshopName
    {
        get => Maintenance.WorkshopName;
        set => Maintenance.WorkshopName = CapitalizeEachWord(value);
    }

    private string FormattedInvoiceNumber
    {
        get => Maintenance.InvoiceNumber;
        set => Maintenance.InvoiceNumber = CapitalizeEachWord(value);
    }

    private string FormattedNotes
    {
        get => Maintenance.Notes;
        set => Maintenance.Notes = CapitalizeEachWord(value);
    }

    private async Task HandleSubmit()
    {
        if (Maintenance.Id == 0)
        {
            var dto = new MaintenanceForCreationDto
            {
                // ============ CAMPOS ORIGINALES ============
                Date = Maintenance.Date,
                Description = Maintenance.Description,
                Cost = Maintenance.Cost,
                WorkshopName = Maintenance.WorkshopName,
                Mileage = Maintenance.Mileage,
                // ============ CAMPOS NUEVOS ============
                Type = Maintenance.Type,
                Category = Maintenance.Category,
                NextMaintenanceDate = Maintenance.NextMaintenanceDate,
                NextMaintenanceMileage = Maintenance.NextMaintenanceMileage,
                InvoiceNumber = Maintenance.InvoiceNumber,
                Notes = Maintenance.Notes
            };
            _apiResponse = await ApiClient.CreateAsync(Maintenance.VehicleId, dto);
        }
        else
        {
            _apiResponse = await ApiClient.UpdateAsync(Maintenance.Id, Maintenance);
        }

        if (_apiResponse.IsSuccess)
        {
            ToastService.ShowSuccess("¡Guardado con éxito!");
            await OnSaveOrCancel.InvokeAsync();
        }
    }

    private void ClearForm()
    {
        var vehicleId = Maintenance.VehicleId;

        Maintenance = new Maintenance
        {
            VehicleId = vehicleId,
            Date = DateTime.Now,
            Type = Maintenance.MaintenanceType.Preventivo,
            Category = Maintenance.MaintenanceCategory.Revision_General
        };

        _apiResponse = null;
        StateHasChanged();
        ToastService.ShowInfo("Formulario limpiado");
    }

    // Método para capitalizar la primera letra de cada palabra (igual que CustomerForm)
    private string CapitalizeEachWord(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        TextInfo textInfo = new CultureInfo("es-ES", false).TextInfo;
        return textInfo.ToTitleCase(input.ToLower());
    }

    // Métodos para mostrar textos en español
    private string GetMaintenanceTypeText(Maintenance.MaintenanceType type) => type switch
    {
        Maintenance.MaintenanceType.Preventivo => "Preventivo",
        Maintenance.MaintenanceType.Correctivo => "Correctivo",
        Maintenance.MaintenanceType.Predictivo => "Predictivo",
        Maintenance.MaintenanceType.Programado => "Programado",
        _ => type.ToString()
    };

    private string GetMaintenanceCategoryText(Maintenance.MaintenanceCategory category) => category switch
    {
        Maintenance.MaintenanceCategory.Motor => "Motor",
        Maintenance.MaintenanceCategory.Transmision => "Transmisión",
        Maintenance.MaintenanceCategory.Frenos => "Frenos",
        Maintenance.MaintenanceCategory.Suspension => "Suspensión",
        Maintenance.MaintenanceCategory.Sistema_Electrico => "Sistema Eléctrico",
        Maintenance.MaintenanceCategory.Neumaticos => "Neumáticos",
        Maintenance.MaintenanceCategory.Aire_Acondicionado => "Aire Acondicionado",
        Maintenance.MaintenanceCategory.Carroceria => "Carrocería",
        Maintenance.MaintenanceCategory.Revision_General => "Revisión General",
        Maintenance.MaintenanceCategory.Otros => "Otros",
        _ => category.ToString()
    };
}
