@page "/dashboard"
@inject CarRental.Web.Services.DashboardApiClient DashboardApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@using Blazored.Toast.Services
@using CarRental.Web.Services

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-6">
    <div class="max-w-7xl mx-auto">

        <!-- Header -->
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Dashboard - @GetGreeting() 👋</h1>
            <p class="text-gray-600 mt-1">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</p>
        </div>

        @if (isLoadingPermissions)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <div class="flex flex-col items-center justify-center space-y-4">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                    <p class="text-gray-600 text-lg">Cargando información...</p>
                </div>
            </div>
        }
        else if (!hasModuleAccess || !canView)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <p class="text-gray-800 text-lg">Acceso no autorizado</p>
                <p class="text-gray-600 text-sm mt-2">No tienes permisos para acceder al dashboard</p>
            </div>
        }
        else
        {
            @if (isLoadingData)
            {
                <div class="bg-white p-8 rounded-xl shadow text-center">
                    <div class="flex flex-col items-center justify-center space-y-4">
                        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                        <p class="text-gray-600 text-lg">Cargando datos...</p>
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded">
                    <p class="text-red-800">@errorMessage</p>
                </div>
            }
            else
            {
                <!-- KPIs Principales -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">

                    <!-- Total Flota -->
                    <div class="bg-white rounded-xl shadow p-6 border-l-4 border-blue-600">
                        <div class="flex items-center justify-between mb-4">
                            <div class="bg-blue-100 p-3 rounded-lg">
                                <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 uppercase font-medium">Total Flota</p>
                        <p class="text-3xl font-bold text-gray-800 mt-1">@GetTotalVehiculos()</p>
                        <p class="text-sm text-gray-600 mt-2">@vehiculosAlquilados.Count alquilados • @vehiculosDisponibles.Count disponibles</p>
                    </div>

                    <!-- Tasa de Ocupación -->
                    <div class="bg-white rounded-xl shadow p-6 border-l-4 border-green-600">
                        <div class="flex items-center justify-between mb-4">
                            <div class="bg-green-100 p-3 rounded-lg">
                                <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 uppercase font-medium">Tasa de Ocupación</p>
                        <p class="text-3xl font-bold text-gray-800 mt-1">@GetOccupancyRate()%</p>
                        <p class="text-sm text-gray-600 mt-2">Eficiencia operativa</p>
                    </div>

                    <!-- Ingresos Activos -->
                    <div class="bg-white rounded-xl shadow p-6 border-l-4 border-purple-600">
                        <div class="flex items-center justify-between mb-4">
                            <div class="bg-purple-100 p-3 rounded-lg">
                                <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 uppercase font-medium">Ingresos Activos</p>
                        <p class="text-3xl font-bold text-gray-800 mt-1">@GetActiveRevenue()</p>
                        <p class="text-sm text-gray-600 mt-2">De @vehiculosAlquilados.Count alquileres</p>
                    </div>

                    <!-- Cumpleaños Hoy -->
                    <div class="bg-white rounded-xl shadow p-6 border-l-4 border-yellow-500">
                        <div class="flex items-center justify-between mb-4">
                            <div class="bg-yellow-100 p-3 rounded-lg">
                                <span class="text-3xl">🎂</span>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 uppercase font-medium">Cumpleaños Hoy</p>
                        <p class="text-3xl font-bold text-gray-800 mt-1">@dashboardData.TodayBirthdays.Count</p>
                        <p class="text-sm text-gray-600 mt-2">@(dashboardData.TodayBirthdays.Count == 1 ? "Cliente" : "Clientes") celebrando</p>
                    </div>
                </div>

                <!-- Grid: Gráficos -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">

                    <!-- Gráfico Estado de Flota -->
                    <div class="lg:col-span-1 bg-white rounded-xl shadow p-6">
                        <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                            </svg>
                            Estado de la Flota
                        </h3>
                        <canvas id="fleetStatusChart" style="max-height: 300px;"></canvas>
                        <div class="mt-4 space-y-2">
                            <div class="flex items-center justify-between text-sm">
                                <div class="flex items-center">
                                    <div class="w-3 h-3 rounded-full bg-green-500 mr-2"></div>
                                    <span class="text-gray-600">Alquilados</span>
                                </div>
                                <span class="font-bold text-gray-800">@vehiculosAlquilados.Count</span>
                            </div>
                            <div class="flex items-center justify-between text-sm">
                                <div class="flex items-center">
                                    <div class="w-3 h-3 rounded-full bg-blue-500 mr-2"></div>
                                    <span class="text-gray-600">Disponibles</span>
                                </div>
                                <span class="font-bold text-gray-800">@vehiculosDisponibles.Count</span>
                            </div>
                        </div>
                    </div>

                    <!-- Gráfico Propiedad -->
                    <div class="lg:col-span-2 bg-white rounded-xl shadow p-6">
                        <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                            Distribución por Propiedad
                        </h3>
                        <canvas id="ownershipChart" style="max-height: 300px;"></canvas>
                    </div>
                </div>

                <!-- Alquileres Activos -->
                <div class="bg-white rounded-xl shadow mb-6">
                    <div class="bg-green-600 px-6 py-4 rounded-t-xl">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-bold text-white flex items-center">
                                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Alquileres Activos
                            </h2>
                            <span class="bg-green-700 px-3 py-1 rounded-full text-sm text-white">
                                @vehiculosAlquilados.Count
                            </span>
                        </div>
                    </div>

                    @if (!vehiculosAlquilados.Any())
                    {
                        <div class="p-8 text-center">
                            <p class="text-gray-500">No hay vehículos alquilados</p>
                        </div>
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase">Vehículo</th>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase">Cliente</th>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase">Propiedad</th>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase">Retorno</th>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-700 uppercase">Días Restantes</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    @foreach (var vehiculo in vehiculosAlquilados)
                                    {
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4">
                                                <div class="font-semibold text-gray-900">@vehiculo.Make @vehiculo.Model</div>
                                                <div class="text-sm text-gray-600">@vehiculo.Year • @vehiculo.LicensePlate</div>
                                            </td>
                                            <td class="px-6 py-4 text-sm text-gray-900">@vehiculo.CustomerName</td>
                                            <td class="px-6 py-4">
                                                @if (vehiculo.Ownership == "Empresa")
                                                {
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                        🏢 Empresa
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                                        👤 Socio
                                                    </span>
                                                }
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="text-sm text-gray-900">@vehiculo.EndDate?.ToString("dd/MM/yyyy")</div>
                                                <div class="text-xs text-gray-500">@vehiculo.EndDate?.ToString("HH:mm")</div>
                                            </td>
                                            <td class="px-6 py-4">
                                                @{
                                                    var days = GetDaysRemaining(vehiculo.EndDate);
                                                }
                                                @if (days < 0)
                                                {
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                                        ⚠️ Vencido
                                                    </span>
                                                }
                                                else if (days == 0)
                                                {
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">
                                                        ⏰ Hoy
                                                    </span>
                                                }
                                                else if (days <= 2)
                                                {
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">
                                                        📅 @days día@(days == 1 ? "" : "s")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                                                        ✓ @days días
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <!-- Grid: Disponibles + Cumpleaños -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                    <!-- Disponibles -->
                    <div class="bg-white rounded-xl shadow">
                        <div class="bg-blue-600 px-6 py-4 rounded-t-xl">
                            <h2 class="text-xl font-bold text-white">Vehículos Disponibles (@vehiculosDisponibles.Count)</h2>
                        </div>

                        @if (!vehiculosDisponibles.Any())
                        {
                            <div class="p-8 text-center">
                                <p class="text-gray-500">No hay vehículos disponibles</p>
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-gray-200">
                                @foreach (var vehiculo in vehiculosDisponibles.Take(5))
                                {
                                    <div class="p-4 hover:bg-gray-50">
                                        <div class="flex justify-between items-center">
                                            <div>
                                                <div class="font-semibold text-gray-900">@vehiculo.Make @vehiculo.Model</div>
                                                <div class="text-sm text-gray-600">@vehiculo.LicensePlate • @vehiculo.Year</div>
                                            </div>
                                            <div class="text-right">
                                                <div class="text-lg font-bold text-green-600">$@vehiculo.DailyRate.ToString("N0")</div>
                                                <div class="text-xs text-gray-500">por día</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Cumpleaños -->
                    <div class="bg-white rounded-xl shadow">
                        <div class="bg-yellow-500 px-6 py-4 rounded-t-xl">
                            <h2 class="text-xl font-bold text-white flex items-center">
                                <span class="mr-2">🎂</span>
                                Cumpleaños Hoy (@dashboardData.TodayBirthdays.Count)
                            </h2>
                        </div>

                        @if (!dashboardData.TodayBirthdays.Any())
                        {
                            <div class="p-8 text-center">
                                <span class="text-5xl mb-2 block">🎉</span>
                                <p class="text-gray-500">No hay cumpleaños hoy</p>
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-gray-200">
                                @foreach (var birthday in dashboardData.TodayBirthdays)
                                {
                                    <div class="p-4 hover:bg-gray-50">
                                        <div class="flex items-center">
                                            <div class="bg-yellow-100 p-2 rounded-full mr-3">
                                                <span class="text-2xl">🎉</span>
                                            </div>
                                            <div class="flex-1">
                                                <div class="font-semibold text-gray-900">@birthday.CustomerName</div>
                                                <div class="text-sm text-gray-600">@birthday.Age años • @birthday.PhoneNumber</div>
                                            </div>
                                            <div class="text-yellow-600 font-bold text-xl">@birthday.Age</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool isLoadingPermissions = true;
    private bool isLoadingData = false;
    private bool hasModuleAccess = false;
    private bool canView = false;
    private string errorMessage = string.Empty;

    private DashboardDataDto dashboardData = new();
    private List<VehicleInfoDto> vehiculosAlquilados = new();
    private List<VehicleInfoDto> vehiculosDisponibles = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();
        if (hasModuleAccess && canView)
        {
            await LoadDashboardData();
        }
        isLoadingPermissions = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isLoadingData && hasModuleAccess && canView)
        {
            await InitializeCharts();
        }
    }

    private async Task LoadPermissions()
    {
        try
        {
            var result = await PermissionApiClient.GetModulePermissionsAsync("Dashboard");
            if (result != null)
            {
                hasModuleAccess = result.HasAccess;
                canView = result.CanView;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            hasModuleAccess = false;
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            isLoadingData = true;
            errorMessage = string.Empty;

            var result = await DashboardApiClient.GetDashboardDataAsync();
            if (result.IsSuccess && result.Data != null)
            {
                dashboardData = result.Data;

                var vehiclesResult = await DashboardApiClient.GetVehiclesInfoAsync();
                if (vehiclesResult.IsSuccess && vehiclesResult.Data != null)
                {
                    vehiculosAlquilados = vehiclesResult.Data.Where(v => v.State == "Alquilado").ToList();
                    vehiculosDisponibles = vehiclesResult.Data.Where(v => v.State == "Disponible").ToList();
                }
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Error al cargar datos";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoadingData = false;
        }
    }

    private async Task InitializeCharts()
    {
        try
        {
            var fleetData = new
            {
                labels = new[] { "Alquilados", "Disponibles" },
                datasets = new[] {
                    new {
                        data = new[] { vehiculosAlquilados.Count, vehiculosDisponibles.Count },
                        backgroundColor = new[] { "#10b981", "#3b82f6" },
                        borderWidth = 0
                    }
                }
            };
            await JSRuntime.InvokeVoidAsync("createDoughnutChart", "fleetStatusChart", fleetData);

            var empresaAlq = vehiculosAlquilados.Count(v => v.Ownership == "Empresa");
            var socioAlq = vehiculosAlquilados.Count(v => v.Ownership == "Socio");
            var empresaDis = vehiculosDisponibles.Count(v => v.Ownership == "Empresa");
            var socioDis = vehiculosDisponibles.Count(v => v.Ownership == "Socio");

            var ownershipData = new
            {
                labels = new[] { "Empresa", "Socio" },
                datasets = new[] {
                    new { label = "Alquilados", data = new[] { empresaAlq, socioAlq }, backgroundColor = "#10b981" },
                    new { label = "Disponibles", data = new[] { empresaDis, socioDis }, backgroundColor = "#3b82f6" }
                }
            };
            await JSRuntime.InvokeVoidAsync("createBarChart", "ownershipChart", ownershipData);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error gráficos: {ex.Message}");
        }
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Buenos días";
        if (hour < 18) return "Buenas tardes";
        return "Buenas noches";
    }

    private int GetTotalVehiculos() => vehiculosAlquilados.Count + vehiculosDisponibles.Count;

    private int GetOccupancyRate()
    {
        var total = GetTotalVehiculos();
        return total == 0 ? 0 : (int)Math.Round((double)vehiculosAlquilados.Count / total * 100);
    }

    private string GetActiveRevenue()
    {
        var total = vehiculosAlquilados.Sum(v => v.DailyRate);
        return total.ToString("C0");
    }

    private int GetDaysRemaining(DateTime? endDate)
    {
        if (!endDate.HasValue) return 0;
        return (endDate.Value.Date - DateTime.Now.Date).Days;
    }
}
