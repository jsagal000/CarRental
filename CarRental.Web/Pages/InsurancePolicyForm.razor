@using CarRental.Core.Models
@using CarRental.Web.Models
@using CarRental.Web.Services
@using Blazored.Toast.Services
@using System.Text.Json
@using CarRental.Core.Models.Dtos
@using System.Globalization
@inject IVehicleSubResourceApiClient<InsurancePolicy, InsurancePolicyForCreationDto> ApiClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-4 font-sans flex flex-col items-center">
    <div class="w-full max-w-2xl bg-white p-6 rounded-lg shadow-md">
    <div class="flex justify-between items-center mb-6">
        <h3 class="text-2xl font-bold text-gray-800">@(Policy.Id == 0 ? "Añadir Nueva Póliza" : "Editar Póliza")</h3>
        @if (Policy.Id == 0)
        {
            <button type="button"
                    @onclick="ClearForm"
                    class="text-blue-600 hover:text-blue-800 underline text-sm font-medium transition-colors duration-200">
                Limpiar formulario
            </button>
        }
    </div>
    <EditForm Model="Policy" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <!-- Muestra errores de validación del servidor -->
        @if (_apiResponse != null && !_apiResponse.IsSuccess)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <strong class="font-bold">¡Error!</strong>
                <span class="block sm:inline">@_apiResponse.ErrorMessage</span>
                @if (_apiResponse.ValidationErrors != null)
                {
                    <ul class="list-disc ml-5 mt-2">
                        @foreach (var error in _apiResponse.ValidationErrors.SelectMany(err => err.Value))
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Aseguradora:</label>
                <InputText @bind-Value="FormattedInsurerName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.InsurerName)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Tipo de Póliza:</label>
                <InputSelect @bind-Value="Policy.TypePolicy" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var type in Enum.GetValues<InsurancePolicy.InsurancePolicyType>())
                    {
                        <option value="@type">@GetPolicyTypeText(type)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Policy.TypePolicy)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Monto de Cobertura:</label>
                <InputNumber @bind-Value="Policy.CoverageAmount" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.CoverageAmount)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Tasa:</label>
                <InputNumber @bind-Value="Policy.Rate" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.Rate)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Prima:</label>
                <InputNumber @bind-Value="Policy.InsurancePremium" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.InsurancePremium)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Número cuotas:</label>
                <InputNumber @bind-Value="Policy.NumberOfInstallments" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.NumberOfInstallments)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">cuota mensual:</label>
                <InputNumber @bind-Value="Policy.MonthlyInstallment" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.MonthlyInstallment)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Fecha de Inicio:</label>
                <InputDate @bind-Value="Policy.StartDate" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.StartDate)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Fecha de Fin:</label>
                <InputDate @bind-Value="Policy.EndDate" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.EndDate)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Deducible:</label>
                <InputNumber @bind-Value="Policy.Deducible" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Policy.Deducible)" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Estado:</label>
                <InputSelect @bind-Value="Policy.Status" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var status in Enum.GetValues<InsurancePolicy.PolicyStatus>())
                    {
                        <option value="@status">@GetPolicyStatusText(status)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Policy.Status)" />
            </div>
            <div class="flex items-center md:col-span-2">
                <label class="flex items-center">
                    <InputCheckbox @bind-Value="Policy.AutoRenew" class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded" />
                    <span class="text-sm font-medium text-gray-700">¿Se renueva automáticamente?</span>
                </label>
            </div>

            <!-- Separador visual -->
            <div class="md:col-span-2 border-t border-gray-300 pt-4 mt-2">
                <h4 class="text-lg font-semibold text-gray-700 mb-3">Información de Contacto</h4>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Teléfono de Emergencia:</label>
                <InputText @bind-Value="Policy.EmergencyPhone" type="tel" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" placeholder="Ej: 1-800-SEGURO" />
                <ValidationMessage For="@(() => Policy.EmergencyPhone)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Nombre del Agente:</label>
                <InputText @bind-Value="FormattedAgentName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" placeholder="Ej: Juan Pérez" />
                <ValidationMessage For="@(() => Policy.AgentName)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Teléfono del Agente:</label>
                <InputText @bind-Value="Policy.AgentPhone" type="tel" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" placeholder="Ej: 099-123-4567" />
                <ValidationMessage For="@(() => Policy.AgentPhone)" />
            </div>
        </div>

        <div class="flex justify-end space-x-4 pt-6">
            <button type="button" @onclick="() => OnSaveOrCancel.InvokeAsync()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-400 transition duration-300 ease-in-out shadow-md font-semibold">Cancelar</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">Guardar</button>
        </div>
    </EditForm>
</div>
</div>

@code {
    [Parameter] public InsurancePolicy Policy { get; set; }
    [Parameter] public EventCallback OnSaveOrCancel { get; set; }

    private ApiResponse _apiResponse;

    // ============ PROPIEDADES FORMATEADAS CON CAPITALIZACIÓN AUTOMÁTICA ============

    private string FormattedInsurerName
    {
        get => Policy.InsurerName;
        set => Policy.InsurerName = CapitalizeEachWord(value);
    }

    // private string FormattedPolicyType
    // {
    //     get => Policy.PolicyType;
    //     set => Policy.PolicyType = CapitalizeEachWord(value);
    // }

    private string FormattedAgentName
    {
        get => Policy.AgentName;
        set => Policy.AgentName = CapitalizeEachWord(value);
    }

    private async Task HandleSubmit()
    {
        // El log de depuración sigue siendo útil
        var policyAsJson = JsonSerializer.Serialize(Policy);

        var dto = new InsurancePolicyForCreationDto
        {
            InsurerName = Policy.InsurerName,
            // PolicyType = Policy.PolicyType,
            TypePolicy = Policy.TypePolicy,
            Status = Policy.Status,
            CoverageAmount = Policy.CoverageAmount,
            Rate = Policy.Rate,
            InsurancePremium = Policy.InsurancePremium,
            NumberOfInstallments = Policy.NumberOfInstallments,
            MonthlyInstallment = Policy.MonthlyInstallment,
            StartDate = Policy.StartDate,
            EndDate = Policy.EndDate,
            Deducible = Policy.Deducible,
            AutoRenew = Policy.AutoRenew,
            EmergencyPhone = Policy.EmergencyPhone,
            AgentName = Policy.AgentName,
            AgentPhone = Policy.AgentPhone
        };
        await JSRuntime.InvokeVoidAsync("console.log", "Datos que se enviarán a la API:", policyAsJson);

        if (Policy.Id == 0)
        {
            // Para la creación, el mapeo de Blazor -> DTO es automático.
            _apiResponse = await ApiClient.CreateAsync(Policy.VehicleId, dto);
        }
        else
        {
            // Para la actualización, es mejor asegurarse de enviar el DTO correcto.
            // Aunque el serializador a menudo lo maneja bien, esto es más robusto.
            _apiResponse = await ApiClient.UpdateAsync(Policy.Id, Policy);
        }

        if (_apiResponse.IsSuccess)
        {
            ToastService.ShowSuccess("¡Guardado con éxito!");
            await OnSaveOrCancel.InvokeAsync();
        }
    }

    private void ClearForm()
    {
        var vehicleId = Policy.VehicleId;

        Policy = new InsurancePolicy
        {
            VehicleId = vehicleId,
            StartDate = DateTime.Now,
            EndDate = DateTime.Now.AddYears(1),
            TypePolicy = InsurancePolicy.InsurancePolicyType.Todo_Riesgo,
            Status = InsurancePolicy.PolicyStatus.Activa
        };

        _apiResponse = null;
        StateHasChanged();
        ToastService.ShowInfo("Formulario limpiado");
    }

    // ============ MÉTODO DE CAPITALIZACIÓN (IGUAL QUE CUSTOMERFORM) ============

    private string CapitalizeEachWord(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        TextInfo textInfo = new CultureInfo("es-ES", false).TextInfo;
        return textInfo.ToTitleCase(input.ToLower());
    }

    // ============ MÉTODOS PARA MOSTRAR TEXTOS EN ESPAÑOL ============

    private string GetPolicyStatusText(InsurancePolicy.PolicyStatus status) => status switch
    {
        InsurancePolicy.PolicyStatus.Activa => "Activa",
        InsurancePolicy.PolicyStatus.Vencida => "Vencida",
        InsurancePolicy.PolicyStatus.Cancelada => "Cancelada",
        InsurancePolicy.PolicyStatus.Suspendida => "Suspendida",
        InsurancePolicy.PolicyStatus.Renovacion_Pendiente => "Renovación Pendiente",
        _ => status.ToString()
    };

    private string GetPolicyTypeText(InsurancePolicy.InsurancePolicyType type) => type switch
    {
        InsurancePolicy.InsurancePolicyType.Todo_Riesgo => "Todo Riesgo",
        InsurancePolicy.InsurancePolicyType.Responsabilidad_Civil => "Responsabilidad Civil",
        InsurancePolicy.InsurancePolicyType.Daños_Propios => "Daños Propios",
        InsurancePolicy.InsurancePolicyType.Robo_Incendio => "Robo e Incendio",
        InsurancePolicy.InsurancePolicyType.Basico => "Básico",
        _ => type.ToString()
    };
}