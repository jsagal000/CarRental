@page "/vehicles"
@inject CarRental.Web.Services.VehicleApiClient VehicleApiClient
@inject CarRental.Web.Services.PermissionApiClient PermissionApiClient
@inject NavigationManager NavigationManager
@inject CarRental.Web.Services.ModalService ModalService
@inject IToastService ToastService
@using CarRental.Core.Models
@using Blazored.Toast.Services

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-6">
    <div class="max-w-7xl mx-auto">

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Gestión de Vehículos</h1>
            @if (canCreate)
            {
                <a href="/vehicles/add" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Nuevo Vehículo
                </a>
            }
        </div>

        @if (isLoadingPermissions)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <div class="flex flex-col items-center justify-center space-y-4">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                    <p class="text-gray-600 text-lg">Cargando información...</p>
                </div>
            </div>
        }
        else if (!hasModuleAccess)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <p class="text-gray-800 text-lg">Acceso no autorizado</p>
                <p class="text-gray-600 text-sm mt-2">No tienes permisos para acceder a este módulo</p>
            </div>
        }
        else if (!canView)
        {
            <div class="bg-white p-8 rounded-xl shadow text-center">
                <p class="text-gray-800 text-lg">Acceso no autorizado</p>
                <p class="text-gray-600 text-sm mt-2">No tienes permisos para ver la lista de vehículos</p>
            </div>
        }
        else
        {
            @if (canView)
            {
                <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Buscar</label>
                            <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchChanged"
                                   placeholder="Marca, modelo o placa..."
                                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Propietario</label>
                            <select @bind="filterOwnership" @bind:event="onchange"
                                    class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <option value="">Todos</option>
                                <option value="Empresa">Empresa</option>
                                <option value="Socio">Socio</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex justify-between items-center mt-4">
                        <div class="text-sm text-gray-600">
                            Mostrando @GetPagedVehicles().Count() de @filteredVehicles.Count() vehículos (Total: @(allVehicles?.Count() ?? 0))
                        </div>
                        <button @onclick="ClearFilters" class="px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors">
                            Limpiar filtros
                        </button>
                    </div>
                </div>
            }

            @if (allVehicles == null && string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                    Cargando vehículos...
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-red-600 text-lg">
                    @errorMessage
                </div>
            }
            else if (allVehicles != null && !allVehicles.Any())
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                    No hay vehículos registrados.
                    @if (canCreate)
                    {
                        <div class="mt-4">
                            <a href="/vehicles/add" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                                Crear el primer vehículo
                            </a>
                        </div>
                    }
                </div>
            }
            else if (!filteredVehicles.Any())
            {
                <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                    No se encontraron vehículos que coincidan con los filtros aplicados.
                    <div class="mt-4">
                        <button @onclick="ClearFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                            Limpiar filtros
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full bg-white rounded-xl shadow overflow-hidden">
                        <thead class="bg-gray-100 text-gray-600 text-sm uppercase">
                            <tr>
                                <th class="px-3 py-2 text-left">Marca y Modelo</th>
                                <th class="px-3 py-2 text-left">Tipo</th>
                                <th class="px-3 py-2 text-left">Año</th>
                                <th class="px-3 py-2 text-left">Matrícula</th>
                                <th class="px-3 py-2 text-left">Color</th>
                                <th class="px-3 py-2 text-left">Estado</th>
                                <th class="px-3 py-2 text-left">Propietario</th>
                                <th class="px-3 py-2 text-left">Tarifa Diaria</th>
                                @if (canView || canEdit || canDelete)
                                {
                                    <th class="px-3 py-2 text-center">Acciones</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehicle in GetPagedVehicles())
                            {
                                <tr class="border-t border-gray-100 hover:bg-gray-50">
                                    <td class="px-3 py-2 text-gray-800">@($"{vehicle.Make} {vehicle.Model}")</td>
                                    <td class="px-3 py-2 text-gray-800">@vehicle.Type.ToString()</td>
                                    <td class="px-3 py-2 text-gray-800">@vehicle.Year</td>
                                    <td class="px-3 py-2 text-gray-800">@vehicle.LicensePlate</td>
                                    <td class="px-3 py-2 text-gray-800">@vehicle.Color</td>
                                    <td class="px-3 py-2">
                                        <span class="@GetStateClass(vehicle.State)">
                                            @vehicle.State.ToString()
                                        </span>
                                    </td>
                                    <td class="px-3 py-2">
                                        @if (vehicle.Ownership.HasValue)
                                        {
                                            @if (vehicle.Ownership == Vehicle.OwnershipType.Empresa)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                    Empresa
                                                </span>
                                            }
                                            else if (vehicle.Ownership == Vehicle.OwnershipType.Socio)
                                            {
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                    Socio
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                                No especificado
                                            </span>
                                        }
                                    </td>
                                    <td class="px-3 py-2 text-gray-800">@vehicle.DailyRate.ToString("C")</td>
                                    @if (canView || canEdit || canDelete)
                                    {
                                        <td class="px-3 py-2 text-center">
                                            <div class="flex justify-center space-x-2">
                                                @if (canView)
                                                {
                                                    <a href="/vehicles/details/@vehicle.Id" class="p-2 bg-blue-100 text-blue-600 hover:bg-blue-200 rounded-full" title="Ver detalles">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                        </svg>
                                                    </a>
                                                }
                                                @if (canEdit)
                                                {
                                                    <a href="/vehicles/edit/@vehicle.Id" class="p-2 bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded-full" title="Editar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4 9.5-9.5z" />
                                                        </svg>
                                                    </a>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button @onclick="() => ConfirmDelete(vehicle.Id)" class="p-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-full" title="Eliminar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                        </svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (filteredVehicles.Count() > pageSize)
                {
                    <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 mt-2 rounded-b-xl">
                        <div class="flex items-center justify-between">
                            <div class="text-sm text-gray-700">
                                Mostrando @((currentPage - 1) * pageSize + 1) a @(Math.Min(currentPage * pageSize, filteredVehicles.Count())) de @filteredVehicles.Count() resultados
                            </div>
                            <div class="flex space-x-2">
                                <button @onclick="PreviousPage" disabled="@(currentPage == 1)"
                                        class="px-3 py-1 text-sm bg-white border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
                                    Anterior
                                </button>
                                <span class="px-3 py-1 text-sm bg-blue-600 text-white rounded">
                                    @currentPage
                                </span>
                                <button @onclick="NextPage" disabled="@(currentPage* pageSize >= filteredVehicles.Count())"
                                        class="px-3 py-1 text-sm bg-white border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
                                    Siguiente
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

@code {
    private IEnumerable<Vehicle> allVehicles;
    private IEnumerable<Vehicle> filteredVehicles = new List<Vehicle>();
    private string errorMessage = string.Empty;
    private bool isLoadingPermissions = true;

    private int currentPage = 1;
    private int pageSize = 10;
    private System.Threading.Timer searchTimer;

    private bool hasModuleAccess = false;
    private bool canView = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;

    private string _searchTerm = "";
    private string _filterOwnership = "";

    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; }
    }

    private string filterOwnership
    {
        get => _filterOwnership;
        set
        {
            _filterOwnership = value;
            currentPage = 1;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();

        if (hasModuleAccess && canView)
        {
            await LoadVehicles();
        }

        isLoadingPermissions = false;
    }

    private async Task LoadPermissions()
    {
        try
        {
            var perms = await PermissionApiClient.GetModulePermissionsAsync("Vehicle");
            hasModuleAccess = perms.HasAccess;

            if (!hasModuleAccess)
            {
                return;
            }

            canView = perms.CanView;
            canCreate = perms.CanCreate;
            canEdit = perms.CanEdit;
            canDelete = perms.CanDelete;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar permisos: {ex.Message}");
            hasModuleAccess = false;
        }
    }

    private async Task LoadVehicles()
    {
        errorMessage = string.Empty;
        var result = await VehicleApiClient.GetVehiclesAsync();

        if (result.IsSuccess)
        {
            allVehicles = result.Data;
            ApplyFilters();
        }
        else
        {
            allVehicles = new List<Vehicle>();
            filteredVehicles = new List<Vehicle>();
            errorMessage = $"Error al cargar vehículos: {result.ErrorMessage}";
            ToastService.ShowError(errorMessage);
        }
    }

    private void ApplyFilters()
    {
        if (allVehicles == null) return;

        var filtered = allVehicles.AsQueryable();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            var search = searchTerm.ToLower().Trim();
            filtered = filtered.Where(v =>
                (v.Make != null && v.Make.ToLower().Contains(search)) ||
                (v.Model != null && v.Model.ToLower().Contains(search)) ||
                (v.LicensePlate != null && v.LicensePlate.ToLower().Contains(search))
            );
        }

        if (!string.IsNullOrEmpty(filterOwnership))
        {
            if (filterOwnership == "Empresa")
            {
                filtered = filtered.Where(v => v.Ownership == Vehicle.OwnershipType.Empresa);
            }
            else if (filterOwnership == "Socio")
            {
                filtered = filtered.Where(v => v.Ownership == Vehicle.OwnershipType.Socio);
            }
        }

        filteredVehicles = filtered.ToList();
        StateHasChanged();
    }

    private void OnSearchChanged()
    {
        searchTimer?.Dispose();
        searchTimer = new System.Threading.Timer((_) => InvokeAsync(() =>
        {
            currentPage = 1;
            ApplyFilters();
        }), null, 300, System.Threading.Timeout.Infinite);
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        _filterOwnership = "";
        currentPage = 1;
        ApplyFilters();
    }

    private IEnumerable<Vehicle> GetPagedVehicles()
    {
        return filteredVehicles.Skip((currentPage - 1) * pageSize).Take(pageSize);
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (currentPage * pageSize < filteredVehicles.Count())
        {
            currentPage++;
            StateHasChanged();
        }
    }

    private async Task ConfirmDelete(int vehicleId)
    {
        if (!canDelete)
        {
            ToastService.ShowError("No tienes permisos para eliminar vehículos");
            return;
        }

        var vehicle = allVehicles.FirstOrDefault(v => v.Id == vehicleId);
        var vehicleInfo = vehicle != null
            ? $"el vehículo {vehicle.Make} {vehicle.Model} ({vehicle.LicensePlate})"
            : "este vehículo";

        var confirmed = await ModalService.ConfirmDeleteAsync(vehicleInfo);

        if (confirmed)
        {
            await HandleDelete(vehicleId);
        }
    }

    private async Task HandleDelete(int vehicleId)
    {
        // Mostrar loading
        await ModalService.ShowLoadingAsync("Eliminando vehículo...");

        var result = await VehicleApiClient.DeleteVehicleAsync(vehicleId);

        // Cerrar loading
        await ModalService.CloseAsync();

        if (result.IsSuccess)
        {
            await ModalService.ShowSuccessAsync("¡Eliminado!", "El vehículo ha sido eliminado exitosamente.");
            await LoadVehicles();
        }
        else
        {
            await ModalService.ShowErrorAsync("Error al Eliminar", result.ErrorMessage ?? "Ocurrió un error inesperado");
        }
    }

    private string GetStateClass(Vehicle.VehicleState state)
    {
        return state switch
        {
            Vehicle.VehicleState.Disponible => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800",
            Vehicle.VehicleState.Alquilado => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800",
            Vehicle.VehicleState.Mantenimiento => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
            Vehicle.VehicleState.Indisponible => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
            Vehicle.VehicleState.Reservado => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800",
            _ => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
        };
    }
}