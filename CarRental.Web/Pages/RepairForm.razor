@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using CarRental.Web.Models
@using CarRental.Web.Services
@using Blazored.Toast.Services
@using System.Text.Json
@using System.Globalization
@inject IVehicleSubResourceApiClient<Repair, RepairForCreationDto> ApiClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<div class="p-4">
    <h3 class="text-2xl font-bold text-gray-800 mb-6">@(Repair.Id == 0 ? "Añadir Nueva Reparación" : "Editar Reparación")</h3>

    <EditForm Model="Repair" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        @if (_apiResponse != null && !_apiResponse.IsSuccess)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                <strong class="font-bold">¡Error!</strong>
                <span class="block sm:inline">@_apiResponse.ErrorMessage</span>
                @if (_apiResponse.ValidationErrors != null)
                {
                    <ul class="list-disc ml-5 mt-2">
                        @foreach (var error in _apiResponse.ValidationErrors.SelectMany(err => err.Value))
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

            <!-- ============ CAMPOS ORIGINALES ============ -->

            <div>
                <label class="block text-sm font-medium text-gray-700">Fecha:</label>
                <InputDate @bind-Value="Repair.Date" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Repair.Date)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Costo:</label>
                <InputNumber @bind-Value="Repair.Cost" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Repair.Cost)" />
            </div>

            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700">Descripción:</label>
                <InputTextArea @bind-Value="FormattedDescription" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 h-20" />
                <ValidationMessage For="@(() => Repair.Description)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Taller:</label>
                <InputText @bind-Value="FormattedWorkshopName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Repair.WorkshopName)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Kilometraje:</label>
                <InputNumber @bind-Value="Repair.Mileage" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => Repair.Mileage)" />
            </div>

            <div class="flex items-center md:col-span-2">
                <label class="flex items-center">
                    <InputCheckbox @bind-Value="Repair.IsWarranty" class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded" />
                    <span class="text-sm font-medium text-gray-700">¿Es por garantía?</span>
                </label>
            </div>

            <!-- ============ CAMPOS NUEVOS ============ -->

            <div>
                <label class="block text-sm font-medium text-gray-700">Tipo de Reparación:</label>
                <InputSelect @bind-Value="Repair.Type" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var type in Enum.GetValues<Repair.RepairType>())
                    {
                        <option value="@type">@GetRepairTypeText(type)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Repair.Type)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Severidad:</label>
                <InputSelect @bind-Value="Repair.Severity" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var severity in Enum.GetValues<Repair.RepairSeverity>())
                    {
                        <option value="@severity">@GetRepairSeverityText(severity)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Repair.Severity)" />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Estado:</label>
                <InputSelect @bind-Value="Repair.Status" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2">
                    @foreach (var status in Enum.GetValues<Repair.RepairStatus>())
                    {
                        <option value="@status">@GetRepairStatusText(status)</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Repair.Status)" />
            </div>

            <!-- Separador visual -->
            <div class="md:col-span-2 border-t border-gray-300 pt-4 mt-2">
                <h4 class="text-lg font-semibold text-gray-700 mb-3">Información de Seguro y Responsabilidad</h4>
            </div>

            <div class="flex items-center">
                <label class="flex items-center">
                    <InputCheckbox @bind-Value="Repair.IsCoveredByInsurance" class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded" />
                    <span class="text-sm font-medium text-gray-700">¿Cubierto por seguro?</span>
                </label>
            </div>

            <div class="flex items-center">
                <label class="flex items-center">
                    <InputCheckbox @bind-Value="Repair.OccurredDuringRental" class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded" />
                    <span class="text-sm font-medium text-gray-700">¿Ocurrió durante alquiler?</span>
                </label>
            </div>

            <div class="flex items-center md:col-span-2">
                <label class="flex items-center">
                    <InputCheckbox @bind-Value="Repair.CustomerResponsible" class="mr-2 h-4 w-4 text-blue-600 border-gray-300 rounded" />
                    <span class="text-sm font-medium text-gray-700">¿Cliente es responsable?</span>
                </label>
            </div>

            @if (Repair.CustomerResponsible)
            {
                <div>
                    <label class="block text-sm font-medium text-gray-700">Monto a Cobrar al Cliente:</label>
                    <InputNumber @bind-Value="Repair.CustomerCharge" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                    <ValidationMessage For="@(() => Repair.CustomerCharge)" />
                </div>
            }

            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700">Notas Adicionales:</label>
                <InputTextArea @bind-Value="FormattedNotes" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 h-20" placeholder="Detalles del incidente, observaciones del mecánico, etc." />
                <ValidationMessage For="@(() => Repair.Notes)" />
            </div>
        </div>

        <div class="flex justify-end space-x-4 pt-6">
            <button type="button" @onclick="() => OnSaveOrCancel.InvokeAsync()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-400 transition duration-300 ease-in-out shadow-md font-semibold">Cancelar</button>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition duration-300 ease-in-out shadow-md font-semibold">Guardar</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public Repair Repair { get; set; }
    [Parameter] public EventCallback OnSaveOrCancel { get; set; }

    private ApiResponse _apiResponse;

    // Propiedades formateadas con capitalización automática
    private string FormattedDescription
    {
        get => Repair.Description;
        set => Repair.Description = CapitalizeEachWord(value);
    }

    private string FormattedWorkshopName
    {
        get => Repair.WorkshopName;
        set => Repair.WorkshopName = CapitalizeEachWord(value);
    }

    private string FormattedNotes
    {
        get => Repair.Notes;
        set => Repair.Notes = CapitalizeEachWord(value);
    }

    private async Task HandleSubmit()
    {
        if (Repair.Id == 0)
        {
            var dto = new RepairForCreationDto
            {
                // ============ CAMPOS ORIGINALES ============
                Date = Repair.Date,
                Description = Repair.Description,
                Cost = Repair.Cost,
                WorkshopName = Repair.WorkshopName,
                Mileage = Repair.Mileage,
                IsWarranty = Repair.IsWarranty,
                // ============ CAMPOS NUEVOS ============
                Type = Repair.Type,
                Severity = Repair.Severity,
                IsCoveredByInsurance = Repair.IsCoveredByInsurance,
                InsurancePolicyId = Repair.InsurancePolicyId,
                OccurredDuringRental = Repair.OccurredDuringRental,
                RentalId = Repair.RentalId,
                CustomerResponsible = Repair.CustomerResponsible,
                CustomerCharge = Repair.CustomerCharge,
                Status = Repair.Status,
                Notes = Repair.Notes
            };
            _apiResponse = await ApiClient.CreateAsync(Repair.VehicleId, dto);
        }
        else
        {
            _apiResponse = await ApiClient.UpdateAsync(Repair.Id, Repair);
        }

        if (_apiResponse.IsSuccess)
        {
            ToastService.ShowSuccess("¡Guardado con éxito!");
            await OnSaveOrCancel.InvokeAsync();
        }
    }

    // Método para capitalizar la primera letra de cada palabra (igual que CustomerForm)
    private string CapitalizeEachWord(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        TextInfo textInfo = new CultureInfo("es-ES", false).TextInfo;
        return textInfo.ToTitleCase(input.ToLower());
    }

    // Métodos para mostrar textos en español
    private string GetRepairTypeText(Repair.RepairType type) => type switch
    {
        Repair.RepairType.Accidente => "Accidente",
        Repair.RepairType.Desgaste => "Desgaste",
        Repair.RepairType.Vandalismo => "Vandalismo",
        Repair.RepairType.Fallo_Mecanico => "Fallo Mecánico",
        Repair.RepairType.Climatico => "Climático",
        Repair.RepairType.Otros => "Otros",
        _ => type.ToString()
    };

    private string GetRepairSeverityText(Repair.RepairSeverity severity) => severity switch
    {
        Repair.RepairSeverity.Menor => "Menor",
        Repair.RepairSeverity.Moderada => "Moderada",
        Repair.RepairSeverity.Grave => "Grave",
        Repair.RepairSeverity.Total => "Total",
        _ => severity.ToString()
    };

    private string GetRepairStatusText(Repair.RepairStatus status) => status switch
    {
        Repair.RepairStatus.Pendiente => "Pendiente",
        Repair.RepairStatus.En_Diagnostico => "En Diagnóstico",
        Repair.RepairStatus.Aprobada => "Aprobada",
        Repair.RepairStatus.En_Proceso => "En Proceso",
        Repair.RepairStatus.En_Espera_Partes => "En Espera de Partes",
        Repair.RepairStatus.Completada => "Completada",
        Repair.RepairStatus.Cancelada => "Cancelada",
        _ => status.ToString()
    };
}
