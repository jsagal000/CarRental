@page "/audit"
@inject CarRental.Web.Services.AuditApiClient AuditApiClient
@inject CarRental.Web.Services.UserApiClient UserApiClient
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@using CarRental.Core.Models
@using CarRental.Core.Models.Dtos
@using Blazored.Toast.Services
@using System.Globalization

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 p-6">
    <div class="max-w-7xl mx-auto">

        <!-- Encabezado -->
        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-800">Gestión de Auditoría</h1>
                <p class="text-sm text-gray-600 mt-1">
                    Se registran solo acciones que modifican datos (crear, editar, eliminar)
                </p>
            </div>
            @if (auditLogs.Items?.Any() == true)
            {
                <button @onclick="ExportToExcel" disabled="@isExporting" class="inline-flex items-center px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:bg-gray-400 transition-colors">
                    @if (isExporting)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Exportando...</span>
                    }
                    else
                    {
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span>Exportar a Excel</span>
                    }
                </button>
            }
        </div>

        <!-- Filtros -->
        <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Inicio</label>
                    <input type="date" @bind="filter.StartDate" @bind:format="yyyy-MM-dd"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Fecha Fin</label>
                    <input type="date" @bind="filter.EndDate" @bind:format="yyyy-MM-dd"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Módulo</label>
                    <select @bind="filter.Module" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Todos</option>
                        <option value="Customer">Clientes</option>
                        <option value="Vehicle">Vehículos</option>
                        <option value="Rental">Alquileres</option>
                        <option value="Partner">Socios</option>
                        <option value="User">Usuarios</option>
                        <option value="System">Sistema</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Acción</label>
                    <select @bind="filter.Action" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Todas</option>
                        <option value="Create">Crear</option>
                        <option value="Edit">Editar</option>
                        <option value="Delete">Eliminar</option>
                        <option value="Login">Inicio de Sesión</option>
                        <option value="Logout">Cierre de Sesión</option>
                        <option value="PasswordChange">Cambio de Contraseña</option>
                        <option value="PermissionChange">Cambio de Permisos</option>
                        <option value="Export">Exportación</option>
                        <option value="Import">Importación</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Usuario</label>
                    <input type="text" @bind="filter.UserName" placeholder="Nombre de usuario"
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Estado</label>
                    <select @bind="filter.IsSuccess" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="">Todos</option>
                        <option value="true">Exitosos</option>
                        <option value="false">Con Error</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-between items-center mt-4">
                <div class="text-sm text-gray-600">
                    Mostrando @auditLogs.Items.Count() de @auditLogs.TotalCount registros
                </div>
                <div class="flex space-x-2">
                    <button @onclick="LoadAuditLogs" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                        Buscar
                    </button>
                    <button @onclick="ClearFilters" class="px-4 py-2 text-gray-600 hover:text-gray-800 transition-colors">
                        Limpiar filtros
                    </button>
                </div>
            </div>
        </div>

        <!-- Estado de carga o error -->
        @if (auditLogs == null && string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
                Cargando registros de auditoría...
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="bg-white p-6 rounded-xl shadow text-center text-red-600 text-lg">
                @errorMessage
            </div>
        }
        else if (!auditLogs.Items.Any())
        {
            <div class="bg-white p-6 rounded-xl shadow text-center text-gray-600 text-lg">
                No se encontraron registros con los filtros aplicados.
                <div class="mt-4">
                    <button @onclick="ClearFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        Limpiar filtros
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Tabla de auditoría -->
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white rounded-xl shadow overflow-hidden">
                    <thead class="bg-gray-100 text-gray-600 text-sm uppercase">
                        <tr>
                            <th class="px-4 py-3 text-left">Fecha/Hora</th>
                            <th class="px-4 py-3 text-left">Usuario</th>
                            <th class="px-4 py-3 text-left">Módulo</th>
                            <th class="px-4 py-3 text-left">Acción</th>
                            <th class="px-4 py-3 text-left">Entidad</th>
                            <th class="px-4 py-3 text-left">Descripción</th>
                            <th class="px-4 py-3 text-left">Estado</th>
                            <th class="px-4 py-3 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in auditLogs.Items)
                        {
                            <tr class="border-t border-gray-100 hover:bg-gray-50">
                                <td class="px-4 py-3 text-gray-800">
                                    @log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td class="px-4 py-3">
                                    <div class="font-medium text-gray-800">@log.UserFullName</div>
                                    <div class="text-sm text-gray-500">@log.UserName</div>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="@GetModuleBadgeClass(log.Module)">
                                        @GetModuleDisplayName(log.Module)
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="@GetActionBadgeClass(log.Action)">
                                        @GetActionDisplayName(log.Action)
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-gray-800">
                                    @if (log.EntityId.HasValue)
                                    {
                                        <div>ID: @log.EntityId</div>
                                        @if (!string.IsNullOrEmpty(log.EntityName))
                                        {
                                            <div class="text-sm text-gray-500">@log.EntityName</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">-</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-800 max-w-xs">
                                    <div class="truncate" title="@log.Description">
                                        @log.Description
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    @if (log.IsSuccess)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Exitoso
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            Error
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="flex justify-center space-x-2">
                                        <a href="/audit/details/@log.Id" class="p-2 bg-blue-100 text-blue-600 hover:bg-blue-200 rounded-full" title="Ver detalles">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            @if (auditLogs.TotalCount > 0)
            {
                <div class="bg-gray-50 px-4 py-3 border-t border-gray-200 mt-2 rounded-b-xl">
                    <div class="flex items-center justify-between">
                        <div class="text-sm text-gray-700">
                            Mostrando @((filter.Page - 1) * filter.PageSize + 1) a @(Math.Min(filter.Page * filter.PageSize, auditLogs.TotalCount)) de @auditLogs.TotalCount resultados
                        </div>
                        <div class="flex space-x-2">
                            <button @onclick="PreviousPage" disabled="@(!auditLogs.HasPreviousPage)"
                                    class="px-3 py-1 text-sm bg-white border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
                                Anterior
                            </button>
                            <span class="px-3 py-1 text-sm bg-blue-600 text-white rounded">
                                @filter.Page
                            </span>
                            <button @onclick="NextPage" disabled="@(!auditLogs.HasNextPage)"
                                    class="px-3 py-1 text-sm bg-white border border-gray-300 rounded disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50">
                                Siguiente
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private PagedResult<AuditLogDto> auditLogs = new();
    private AuditLogFilterDto filter = new AuditLogFilterDto
    {
        Page = 1,
        PageSize = 10,
        Module = "",
        Action = "",
        UserName = ""
    };
    private string errorMessage = string.Empty;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditLogs();
    }

    private async Task LoadAuditLogs()
    {
        errorMessage = string.Empty;

        try
        {
            var result = await AuditApiClient.GetAuditLogsAsync(filter);

            if (result.IsSuccess)
            {
                auditLogs = result.Data ?? new PagedResult<AuditLogDto>();
            }
            else
            {
                auditLogs = new PagedResult<AuditLogDto>();
                errorMessage = $"Error al cargar registros: {result.ErrorMessage}";
                ToastService.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            auditLogs = new PagedResult<AuditLogDto>();
            errorMessage = $"Error inesperado: {ex.Message}";
            ToastService.ShowError(errorMessage);
        }
    }

    private async Task NextPage()
    {
        if (auditLogs.HasNextPage)
        {
            filter.Page++;
            await LoadAuditLogs();
        }
    }

    private async Task PreviousPage()
    {
        if (auditLogs.HasPreviousPage)
        {
            filter.Page--;
            await LoadAuditLogs();
        }
    }

    private async Task ClearFilters()
    {
        filter = new AuditLogFilterDto
        {
            Page = 1,
            PageSize = 10,
            Module = "",
            Action = "",
            UserName = ""
        };
        await LoadAuditLogs();
    }

    private async Task ExportToExcel()
    {
        if (auditLogs.Items?.Any() != true)
        {
            ToastService.ShowWarning("No hay datos para exportar.");
            return;
        }

        isExporting = true;

        try
        {
            var exportFilter = new AuditLogFilterDto
            {
                StartDate = filter.StartDate,
                EndDate = filter.EndDate,
                Module = filter.Module,
                Action = filter.Action,
                UserName = filter.UserName,
                IsSuccess = filter.IsSuccess,
                Page = 1,
                PageSize = 10000
            };

            var result = await AuditApiClient.GetAuditLogsAsync(exportFilter);

            if (!result.IsSuccess || result.Data?.Items == null)
            {
                ToastService.ShowError("Error al obtener datos para exportar.");
                return;
            }

            var csvContent = GenerateCsvContent(result.Data.Items);
            var filename = $"Auditoria_{DateTime.Now:yyyy-MM-dd_HHmmss}.csv";

            await JSRuntime.InvokeVoidAsync("downloadFile", csvContent, filename, "text/csv;charset=utf-8;");
            ToastService.ShowSuccess($"Archivo exportado: {result.Data.Items.Count()} registros.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al exportar: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GenerateCsvContent(IEnumerable<AuditLogDto> logs)
    {
        var csv = new System.Text.StringBuilder();

        csv.AppendLine("Reporte de Auditoría");
        csv.AppendLine($"Generado: {DateTime.Now:dd/MM/yyyy HH:mm:ss}");

        if (filter.StartDate.HasValue || filter.EndDate.HasValue)
        {
            csv.AppendLine($"Período: {(filter.StartDate?.ToString("dd/MM/yyyy") ?? "Desde inicio")} - {(filter.EndDate?.ToString("dd/MM/yyyy") ?? "Hasta hoy")}");
        }

        if (!string.IsNullOrEmpty(filter.Module))
        {
            csv.AppendLine($"Módulo filtrado: {GetModuleDisplayName(filter.Module)}");
        }

        if (!string.IsNullOrEmpty(filter.Action))
        {
            csv.AppendLine($"Acción filtrada: {GetActionDisplayName(filter.Action)}");
        }

        csv.AppendLine();
        csv.AppendLine($"Total de registros: {logs.Count()}");
        csv.AppendLine();

        csv.AppendLine("\"Fecha/Hora\",\"Usuario\",\"Nombre Completo\",\"Módulo\",\"Acción\",\"ID Entidad\",\"Nombre Entidad\",\"Descripción\",\"Estado\",\"Mensaje Error\",\"IP Address\",\"User Agent\"");

        foreach (var log in logs)
        {
            var fechaHora = log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");
            var usuario = EscapeCsv(log.UserName ?? "");
            var nombreCompleto = EscapeCsv(log.UserFullName ?? "");
            var modulo = EscapeCsv(GetModuleDisplayName(log.Module ?? ""));
            var accion = EscapeCsv(GetActionDisplayName(log.Action ?? ""));
            var entityId = log.EntityId?.ToString() ?? "";
            var entityName = EscapeCsv(log.EntityName ?? "");
            var descripcion = EscapeCsv(log.Description ?? "");
            var estado = log.IsSuccess ? "Exitoso" : "Error";
            var errorMsg = EscapeCsv(log.ErrorMessage ?? "");
            var ip = EscapeCsv(log.IpAddress ?? "");
            var userAgent = EscapeCsv(log.UserAgent ?? "");

            csv.AppendLine($"\"{fechaHora}\",\"{usuario}\",\"{nombreCompleto}\",\"{modulo}\",\"{accion}\",\"{entityId}\",\"{entityName}\",\"{descripcion}\",\"{estado}\",\"{errorMsg}\",\"{ip}\",\"{userAgent}\"");
        }

        csv.AppendLine();
        csv.AppendLine("RESUMEN");
        csv.AppendLine($"Total de acciones exitosas: {logs.Count(l => l.IsSuccess)}");
        csv.AppendLine($"Total de acciones con error: {logs.Count(l => !l.IsSuccess)}");

        var porModulo = logs.GroupBy(l => l.Module).Select(g => new { Modulo = GetModuleDisplayName(g.Key), Cantidad = g.Count() });
        csv.AppendLine();
        csv.AppendLine("Por Módulo:");
        foreach (var item in porModulo)
        {
            csv.AppendLine($"{item.Modulo}: {item.Cantidad}");
        }

        var porAccion = logs.GroupBy(l => l.Action).Select(g => new { Accion = GetActionDisplayName(g.Key), Cantidad = g.Count() });
        csv.AppendLine();
        csv.AppendLine("Por Acción:");
        foreach (var item in porAccion)
        {
            csv.AppendLine($"{item.Accion}: {item.Cantidad}");
        }

        return csv.ToString();
    }

    private string EscapeCsv(string value)
    {
        if (string.IsNullOrEmpty(value))
            return "";

        return value.Replace("\"", "\"\"").Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
    }

    private string GetModuleBadgeClass(string module)
    {
        return module switch
        {
            "Customer" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800",
            "Vehicle" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800",
            "Rental" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800",
            "Partner" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
            "User" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800",
            "System" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800",
            _ => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
        };
    }

    private string GetActionBadgeClass(string action)
    {
        return action switch
        {
            "Create" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800",
            "Edit" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800",
            "Delete" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800",
            "Login" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800",
            "Logout" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800",
            "PasswordChange" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800",
            "PermissionChange" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800",
            "Export" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800",
            "Import" => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 text-cyan-800",
            _ => "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800"
        };
    }

    private string GetModuleDisplayName(string module)
    {
        return module switch
        {
            "Customer" => "Clientes",
            "Vehicle" => "Vehículos",
            "Rental" => "Alquileres",
            "Partner" => "Socios",
            "User" => "Usuarios",
            "System" => "Sistema",
            _ => module
        };
    }

    private string GetActionDisplayName(string action)
    {
        return action switch
        {
            "Create" => "Crear",
            "Edit" => "Editar",
            "Delete" => "Eliminar",
            "Login" => "Inicio de Sesión",
            "Logout" => "Cierre de Sesión",
            "PasswordChange" => "Cambio de Contraseña",
            "PermissionChange" => "Cambio de Permisos",
            "Export" => "Exportación",
            "Import" => "Importación",
            _ => action
        };
    }
}